---
import Article from '../../blog/[slug].astro';
import { getCollection } from 'astro:content';
export async function getStaticPaths() {
  return (await getCollection('blog')).filter(post => !post.data.draft).map(post => ({ params: { slug: post.slug }, props: { post } }));
}
---
<Article post={Astro.props.post} />
