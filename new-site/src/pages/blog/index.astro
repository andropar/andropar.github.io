---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(post => import.meta.env.DEV || !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Blog - Johannes Roth">
  <header class="page-header">
    <h1 class="page-title">Blog</h1>
    <p class="page-description">
      Technical deep-dives and occasional reflections. Coming soon.
    </p>
  </header>

  <section class="section">
    {posts.length > 0 ? (
      <div class="post-list">
        {posts.map(post => {
          const formattedDate = post.data.date.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          });
          return (
            <a href={`/blog/${post.slug}`} class="post-item">
              {post.data.draft && <span class="draft-badge">Draft</span>}
              <span class="post-date">{formattedDate}</span>
              <h3 class="post-title">{post.data.title}</h3>
              <p class="post-excerpt">{post.data.description}</p>
              {post.data.tags.length > 0 && (
                <div class="post-tags">
                  {post.data.tags.map((tag: string) => (
                    <span class="post-tag">{tag}</span>
                  ))}
                </div>
              )}
            </a>
          );
        })}
      </div>
    ) : (
      <div class="empty-state">
        <p>Nothing here yet. Check back soon, or follow along on <a href="https://github.com/andropar" target="_blank" rel="noopener">GitHub</a> in the meantime.</p>
      </div>
    )}
  </section>
</Layout>

<style>
  .empty-state {
    padding: var(--space-3xl) 0;
    text-align: center;
    color: var(--color-text-secondary);
  }

  .empty-state a {
    color: var(--color-text);
  }

  /* Draft badge */
  .draft-badge {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #b45309;
    background: rgba(180, 83, 9, 0.1);
    padding: var(--space-xs) var(--space-sm);
    border-radius: 4px;
    margin-bottom: var(--space-sm);
  }

  /* Post tags */
  .post-tags {
    display: flex;
    gap: var(--space-xs);
    flex-wrap: wrap;
    margin-top: var(--space-sm);
  }

  .post-tag {
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--color-accent);
    background: rgba(90, 90, 90, 0.1);
    padding: 2px var(--space-xs);
    border-radius: 3px;
  }

  [data-theme="dark"] .post-tag {
    background: rgba(150, 150, 150, 0.15);
  }

  .post-item {
    transition: opacity 0.2s ease;
  }

  .post-item:hover {
    opacity: 0.7;
  }

  .post-title {
    transition: color 0.2s ease;
  }

  .post-item:hover .post-title {
    color: var(--color-accent);
  }

  .post-date {
    font-family: var(--font-serif);
    font-style: italic;
  }
</style>
