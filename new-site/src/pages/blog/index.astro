---
import { getCollection } from 'astro:content';
import V2Layout from '../../layouts/V2Layout.astro';
const posts = (await getCollection('blog')).filter(post => !post.data.draft).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<V2Layout title="Writing — Johannes Roth" description="Notes and essays on research, software, and life.">
  <header class="page-head">
    <h1>Writing</h1>
    <p class="page-lede">Things I've learned, built, and been thinking about.</p>
  </header>
  <ul class="entries writing-index">
    {posts.map(post => (
      <li class="entry">
        <time class="entry-meta" datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}</time>
        <div>
          <h2 class="entry-title"><a class="stretched" href={`/blog/${post.slug}`}>{post.data.title}</a></h2>
          <p class="entry-text">{post.data.description}</p>
        </div>
      </li>
    ))}
  </ul>
</V2Layout>
