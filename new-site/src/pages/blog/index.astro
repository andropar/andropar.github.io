---
import Layout from '../../layouts/Layout.astro';

// Empty for now - will add posts later
const posts: Array<{slug: string; title: string; date: string; excerpt: string; tag: string}> = [];
---

<Layout title="Blog - Johannes Roth">
  <header class="page-header">
    <h1 class="page-title">Blog</h1>
    <p class="page-description">
      Technical deep-dives and occasional reflections. Coming soon.
    </p>
  </header>

  <section class="section">
    {posts.length > 0 ? (
      <div class="post-list">
        {posts.map(post => (
          <a href={`/blog/${post.slug}`} class="post-item">
            <span class="post-date">{post.date}</span>
            <h3 class="post-title">{post.title}<span class="post-tag">{post.tag}</span></h3>
            <p class="post-excerpt">{post.excerpt}</p>
          </a>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <p>Nothing here yet. Check back soon, or follow along on <a href="https://github.com/andropar" target="_blank" rel="noopener">GitHub</a> in the meantime.</p>
      </div>
    )}
  </section>
</Layout>

<style>
  .empty-state {
    padding: var(--space-3xl) 0;
    text-align: center;
    color: var(--color-text-secondary);
  }

  .empty-state a {
    color: var(--color-text);
  }

  /* Post list with editorial numbering (for when posts are added) */
  .post-list {
    counter-reset: posts;
  }

  .post-item {
    counter-increment: posts;
    position: relative;
    padding-right: var(--space-3xl);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .post-item::after {
    content: '0' counter(posts);
    position: absolute;
    right: 0;
    top: var(--space-lg);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.75rem;
    color: var(--color-border);
    opacity: 0.5;
    transition: opacity 0.3s ease, color 0.3s ease;
    pointer-events: none;
  }

  .post-item:first-child::after {
    top: 0;
  }

  .post-item:hover {
    transform: translateX(4px);
    opacity: 1;
  }

  .post-item:hover::after {
    opacity: 0.8;
    color: var(--color-accent);
  }

  .post-title {
    transition: color 0.2s ease;
  }

  .post-item:hover .post-title {
    color: var(--color-accent);
  }

  .post-date {
    font-family: var(--font-serif);
    font-style: italic;
  }
</style>
