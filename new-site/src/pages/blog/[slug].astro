---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((post) => !post.data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const formattedDate = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout title={`${post.data.title} - Johannes Roth`} description={post.data.description}>
  <article class="blog-post">
    <header class="post-header">
      <a href="/blog" class="back-link">Back to blog</a>
      <time class="post-date" datetime={post.data.date.toISOString()}>{formattedDate}</time>
      <h1 class="post-title">{post.data.title}</h1>
      {post.data.draft && <span class="draft-badge">Draft</span>}
      {post.data.tags.length > 0 && (
        <div class="post-tags">
          {post.data.tags.map((tag: string) => (
            <span class="post-tag">{tag}</span>
          ))}
        </div>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="post-footer">
      <a href="/blog" class="back-link">Back to all posts</a>
    </footer>
  </article>

  <div class="lightbox" id="lightbox">
    <button class="lightbox-close" aria-label="Close">&times;</button>
    <img class="lightbox-img" id="lightbox-img" src="" alt="" />
  </div>
</Layout>

<script>
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const proseImages = document.querySelectorAll('.prose img');

  proseImages.forEach((img) => {
    img.setAttribute('role', 'button');
    img.setAttribute('tabindex', '0');
    img.addEventListener('click', () => {
      if (!lightboxImg || !lightbox) return;
      lightboxImg.src = (img as HTMLImageElement).src;
      lightboxImg.alt = (img as HTMLImageElement).alt;
      lightbox.classList.add('active');
      document.body.style.overflow = 'hidden';
    });
  });

  lightbox?.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (target === lightbox || target.classList.contains('lightbox-close')) {
      lightbox.classList.remove('active');
      document.body.style.overflow = '';
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && lightbox?.classList.contains('active')) {
      lightbox.classList.remove('active');
      document.body.style.overflow = '';
    }
  });

  import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs').then((mermaid) => {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    mermaid.default.initialize({
      startOnLoad: false,
      theme: isDark ? 'dark' : 'default',
      flowchart: {
        useMaxWidth: true,
        htmlLabels: true,
        curve: 'basis',
      },
    });

    const mermaidBlocks = document.querySelectorAll('pre code.language-mermaid');
    mermaidBlocks.forEach(async (block, index) => {
      const pre = block.parentElement;
      if (!pre) return;

      const code = block.textContent || '';
      const container = document.createElement('div');
      container.className = 'mermaid-diagram';

      try {
        const { svg } = await mermaid.default.render(`mermaid-${index}`, code);
        container.innerHTML = svg;
        pre.replaceWith(container);
      } catch (error) {
        console.error('Mermaid rendering failed:', error);
      }
    });
  });
</script>

<style>
  .blog-post {
    max-width: 720px;
  }

  .post-header {
    margin-bottom: var(--space-3xl);
  }

  .back-link {
    display: inline-flex;
    margin-bottom: var(--space-lg);
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .post-date {
    display: block;
    margin-bottom: var(--space-md);
  }

  .post-title {
    margin-bottom: var(--space-md);
    font-size: clamp(2rem, 7vw, 3.75rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .draft-badge,
  .post-tag {
    display: inline-flex;
    align-items: center;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .draft-badge {
    color: var(--color-text-tertiary);
    background: var(--color-bg-subtle);
    padding: 3px 7px;
    margin-bottom: var(--space-md);
  }

  .post-tags {
    display: flex;
    gap: var(--space-xs);
    flex-wrap: wrap;
    margin-top: var(--space-md);
  }

  .post-tag {
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    padding: 3px 6px;
  }

  .prose {
    font-size: 1.0625rem;
    line-height: 1.8;
  }

  .prose :global(h2) {
    margin-top: var(--space-3xl);
    margin-bottom: var(--space-lg);
    font-size: 1.75rem;
  }

  .prose :global(h3) {
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-md);
    font-size: 1.25rem;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: var(--space-lg);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: var(--space-xl);
  }

  .prose :global(img) {
    width: min(100% + 60px, calc(100vw - 40px));
    max-width: calc(100% + 60px);
    height: auto;
    margin: var(--space-lg) 0 var(--space-lg) -30px;
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    cursor: zoom-in;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .prose :global(img:hover) {
    transform: scale(1.015);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
  }

  .prose :global(.image-row) {
    display: flex;
    gap: var(--space-lg);
    width: calc(100% + 60px);
    margin: var(--space-lg) 0 var(--space-lg) -30px;
  }

  .prose :global(.image-row figure) {
    flex: 1;
    margin: 0;
  }

  .prose :global(.image-row img) {
    width: 100%;
    max-width: 100%;
    margin: 0;
  }

  .prose :global(.image-row figcaption) {
    margin-top: var(--space-sm);
    color: var(--color-text-tertiary);
    font-size: 0.875rem;
    text-align: center;
  }

  .prose :global(.image-float-right) {
    float: right;
    width: 180px;
    max-width: 180px;
    margin: 0 -30px var(--space-lg) var(--space-xl);
  }

  .prose :global(pre) {
    overflow-x: auto;
  }

  .post-footer {
    margin-top: var(--space-4xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-border-subtle);
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    visibility: hidden;
    opacity: 0;
    background: rgba(0, 0, 0, 0.9);
    cursor: zoom-out;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .lightbox.active {
    visibility: visible;
    opacity: 1;
  }

  .lightbox-img {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 8px;
  }

  .lightbox-close {
    position: absolute;
    top: 20px;
    right: 24px;
    border: 0;
    background: none;
    color: white;
    font-size: 2.5rem;
    line-height: 1;
    cursor: pointer;
  }

  @media (max-width: 740px) {
    .prose :global(img),
    .prose :global(.image-row) {
      width: 100%;
      max-width: 100%;
      margin-left: 0;
    }

    .prose :global(.image-row) {
      flex-direction: column;
    }

    .prose :global(.image-float-right) {
      float: none;
      display: block;
      width: 60%;
      max-width: 200px;
      margin: var(--space-lg) auto;
    }
  }
</style>
