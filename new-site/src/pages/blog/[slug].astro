---
import { getCollection } from 'astro:content';
import V2Layout from '../../layouts/V2Layout.astro';
import { readingTime } from '../../data/reading-time';
export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter(post => !post.data.draft).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts.map((post, i) => ({ params: { slug: post.slug }, props: { post, newer: posts[i - 1], older: posts[i + 1] } }));
}
const { post, newer, older } = Astro.props;
const { Content, headings } = await post.render();
const tags: string[] = post.data.tags;
// Long posts get a table of contents in the right column on wide screens.
const contents = headings.filter(heading => heading.depth === 2);
const showContents = contents.length >= 3;
---
<V2Layout title={`${post.data.title} — Johannes Roth`} description={post.data.description}>
  <article class:list={['article', { 'article--contents': showContents }]}>
    <header class="article-head">
      <a class="link-back" href="/blog">All writing</a>
      <h1>{post.data.title}</h1>
      <p class="article-lede">{post.data.description}</p>
      <div class="article-meta">
        <p class="meta"><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time> · {readingTime(post.body)} min read</p>
        {tags.length > 0 && <ul class="pills">{tags.map(tag => <li>{tag}</li>)}</ul>}
      </div>
    </header>
    <div class="article-body">
      <div class="prose"><Content /></div>
      {showContents && (
        <nav class="article-contents" aria-label="Contents">
          <p class="meta">Contents</p>
          <ol>{contents.map(heading => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
        </nav>
      )}
    </div>
    <footer class="article-foot">
      {(newer || older) && (
        <nav class="post-nav" aria-label="More writing">
          {older && <a class="post-nav-link" href={`/blog/${older.slug}`}><span class="meta">Older</span>{older.data.title}</a>}
          {newer && <a class="post-nav-link post-nav-link--newer" href={`/blog/${newer.slug}`}><span class="meta">Newer</span>{newer.data.title}</a>}
        </nav>
      )}
      <div class="link-row">
        <a class="link" href="/blog">All writing</a>
        <a class="link" href="mailto:johannes@roth24.de">Have a thought? Say hi</a>
      </div>
    </footer>
  </article>
  <dialog class="image-viewer" aria-label="Expanded article image">
    <button class="icon-button image-viewer-close" type="button" aria-label="Close image">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
    </button>
    <img alt="" />
  </dialog>
</V2Layout>
<script>
  const viewer = document.querySelector<HTMLDialogElement>('.image-viewer');
  const expandedImage = viewer?.querySelector('img');
  document.querySelectorAll<HTMLImageElement>('.prose img').forEach(image => {
    if (image.closest('a') || !viewer || !expandedImage) return;
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'article-image-button';
    if (image.classList.contains('image-float-right')) button.classList.add('is-floated');
    button.setAttribute('aria-label', `Enlarge image: ${image.alt || 'Article illustration'}`);
    image.replaceWith(button);
    button.append(image);
    button.addEventListener('click', () => {
      expandedImage.src = image.currentSrc || image.src;
      expandedImage.alt = image.alt;
      viewer.showModal();
    });
  });
  viewer?.querySelector('button')?.addEventListener('click', () => viewer.close());

  // Mark the section being read in the contents list.
  const contentLinks = new Map([...document.querySelectorAll<HTMLAnchorElement>('.article-contents a')].map(link => [decodeURIComponent(link.hash.slice(1)), link]));
  if (contentLinks.size) {
    const observer = new IntersectionObserver(entries => {
      entries.filter(entry => entry.isIntersecting).forEach(entry => {
        contentLinks.forEach(link => link.removeAttribute('aria-current'));
        contentLinks.get(entry.target.id)?.setAttribute('aria-current', 'true');
      });
    }, { rootMargin: '0px 0px -70% 0px' });
    contentLinks.forEach((_, id) => { const heading = document.getElementById(id); if (heading) observer.observe(heading); });
  }
  viewer?.addEventListener('click', event => { if (event.target === viewer) viewer.close(); });
</script>
