      linear-gradient(98deg, rgba(86, 146, 101, 0.16), rgba(218, 155, 50, 0.08) 48%, rgba(178, 70, 58, 0.12)),
      rgba(255, 255, 255, 0.026) !important;
  }

  .mode-content,
  .mode-section {
    animation: fadeInUp 0.36s ease-out;
  }

  @media (min-width: 761px) {
