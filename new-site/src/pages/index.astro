  .personal-section-cta {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    flex-shrink: 0;
    margin-bottom: 0.28em;
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.2;
    text-decoration: none;
    transition: color 0.18s ease, transform 0.18s ease;
