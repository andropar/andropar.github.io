<script>
  // ── Professional / personal page flip ──
  (function() {
    const shell = document.querySelector('.mode-shell');
    const toggle = document.querySelector('.mode-toggle');
    const scrollCue = document.querySelector('.scroll-cue');
    const navLinks = Array.from(document.querySelectorAll('#site-navigation .nav-link'));
    if (!shell || !toggle) return;

    const onHome = window.location.pathname === '/' || window.location.pathname.endsWith('/index.html');
    const navSets = {
      professional: [
        { href: 'capabilities', label: 'skills' },
        { href: 'experience', label: 'experience' },
        { href: 'work', label: 'work' },
      ],
      personal: [
        { href: 'personal-life', label: 'about' },
        { href: 'personal-shelves', label: 'shelves' },
        { href: 'personal-notes', label: 'notes' },
      ],
    };

    function sectionHref(id) {
      return onHome ? `#${id}` : `/#${id}`;
    }

    function syncThemeForMode(mode) {
      const theme = mode === 'personal' ? 'light' : 'dark';
      const nextTheme = theme === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', theme);
      try {
        localStorage.setItem('theme', theme);
      } catch (error) {
        // The active page can still switch themes without local storage.
      }

      const themeToggle = document.querySelector('.theme-toggle');
      if (themeToggle) {
        themeToggle.setAttribute('aria-label', `Switch to ${nextTheme} mode`);
        themeToggle.setAttribute('title', `Switch to ${nextTheme} mode`);
        themeToggle.setAttribute('aria-pressed', String(theme === 'dark'));
      }
    }

    function getInitialMode() {
      return window.location.hash.indexOf('#personal-') === 0 ? 'personal' : 'professional';
    }

    function setMode(mode) {
      const nextMode = mode === 'personal' ? 'personal' : 'professional';
      const isPersonal = nextMode === 'personal';
      shell.dataset.siteMode = nextMode;
      document.documentElement.dataset.siteMode = nextMode;
      syncThemeForMode(nextMode);
      toggle.setAttribute('aria-pressed', String(isPersonal));
      toggle.setAttribute('aria-label', isPersonal ? 'Back to my professional work' : 'Learn more about my life outside work');

      document.querySelectorAll('.hero-portrait--professional').forEach((portrait) => {
        portrait.setAttribute('aria-hidden', String(isPersonal));
        portrait.style.opacity = isPersonal ? '0' : '1';
      });
      document.querySelectorAll('.hero-portrait--personal').forEach((portrait) => {
        portrait.setAttribute('aria-hidden', String(!isPersonal));
        portrait.style.opacity = isPersonal ? '1' : '0';
      });

      const activeNav = navSets[nextMode];
      navLinks.forEach((link, index) => {
        const item = activeNav[index];
        if (!item) return;
        link.setAttribute('href', sectionHref(item.href));
        link.textContent = item.label;
      });

      if (scrollCue) {
        const target = isPersonal ? 'personal-life' : 'capabilities';
        scrollCue.setAttribute('href', sectionHref(target));
        scrollCue.setAttribute('aria-label', isPersonal ? 'Scroll to about me' : 'Scroll to what I can do');
      }

    }
    setMode(getInitialMode());

    toggle.addEventListener('click', () => {
      const nextMode = shell.dataset.siteMode === 'personal' ? 'professional' : 'personal';
      setMode(nextMode);
    });
  })();

  // Expand the personal reading archive under the shelf grid.
  (function() {
    const toggle = document.querySelector('[data-books-archive-toggle]');
    const archive = document.getElementById('personal-books-archive-panel');
    if (!toggle || !archive) return;
    let hasStartedCoverPrefetch = false;
    let currentCoverReadyPromise;

    function waitForCurrentBookCovers() {
      if (currentCoverReadyPromise) return currentCoverReadyPromise;
      const currentCovers = Array.from(document.querySelectorAll('[data-current-book-cover]'));
      const pendingCovers = currentCovers.filter((image) => !image.complete);
      if (!pendingCovers.length) {
        currentCoverReadyPromise = Promise.resolve();
        return currentCoverReadyPromise;
      }

      currentCoverReadyPromise = Promise.all(
        pendingCovers.map((image) => new Promise((resolve) => {
          image.addEventListener('load', resolve, { once: true });
          image.addEventListener('error', resolve, { once: true });
        })),
      ).then(() => undefined);
      return currentCoverReadyPromise;
    }

    function prefetchArchiveCovers() {
      if (hasStartedCoverPrefetch) return;
      hasStartedCoverPrefetch = true;
      const coverUrls = Array.from(archive.querySelectorAll('[data-prefetch-book-cover]'))
        .map((image) => image.getAttribute('src'))
        .filter(Boolean);
      const queue = [...new Set(coverUrls)];
      const maxConcurrent = 4;
      let active = 0;

      function loadNext() {
        while (active < maxConcurrent && queue.length) {
          const url = queue.shift();
          const image = new Image();
          active += 1;
          image.decoding = 'async';
          if ('fetchPriority' in image) {
            image.fetchPriority = 'low';
          }
          image.onload = image.onerror = () => {
            active -= 1;
            loadNext();
          };
          image.src = url;
        }
      }

      loadNext();
    }

    const scheduleCoverPrefetch = () => {
      const start = () => waitForCurrentBookCovers().then(prefetchArchiveCovers);
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(start, { timeout: 2500 });
      } else {
        window.setTimeout(start, 900);
      }
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      if (!isOpen) waitForCurrentBookCovers().then(prefetchArchiveCovers);
      toggle.setAttribute('aria-expanded', String(!isOpen));
      archive.hidden = isOpen;
    });

    toggle.addEventListener('pointerenter', () => waitForCurrentBookCovers().then(prefetchArchiveCovers));
    toggle.addEventListener('focus', () => waitForCurrentBookCovers().then(prefetchArchiveCovers));
    scheduleCoverPrefetch();
  })();

  // Expand Datasets & Tools notes near the selected card.
  (function() {
    const toolsList = document.querySelector('.tools-list');
    const toggles = Array.from(document.querySelectorAll('[data-tool-notes-toggle]'));
    const panels = Array.from(document.querySelectorAll('[data-tool-notes-panel]'));
    const mobileNotesQuery = window.matchMedia('(max-width: 760px)');
    if (!toolsList || !toggles.length || !panels.length) return;

    function placePanel(panel, toggle) {
      const entry = toggle.closest('.tool-entry');
      if (mobileNotesQuery.matches && entry) {
        if (panel.parentElement !== entry) entry.appendChild(panel);
        return;
      }

      if (panel.parentElement !== toolsList) toolsList.appendChild(panel);
    }

    function setActivePanel(panelId) {
      const activeToggle = toggles.find((toggle) => toggle.dataset.toolNotesToggle === panelId);
      const activePanel = panels.find((panel) => panel.id === panelId);
      if (activeToggle && activePanel) placePanel(activePanel, activeToggle);

      toggles.forEach((toggle) => {
        const isActive = toggle.dataset.toolNotesToggle === panelId;
        toggle.setAttribute('aria-expanded', String(isActive));
      });

      panels.forEach((panel) => {
        panel.hidden = panel.id !== panelId;
      });
    }

    function closePanels() {
      toggles.forEach((toggle) => toggle.setAttribute('aria-expanded', 'false'));
      panels.forEach((panel) => {
        panel.hidden = true;
      });
    }

    toggles.forEach((toggle) => {
      toggle.addEventListener('click', () => {
        const panelId = toggle.dataset.toolNotesToggle;
        const isOpen = toggle.getAttribute('aria-expanded') === 'true';
        if (!panelId || isOpen) {
          closePanels();
          return;
        }
        setActivePanel(panelId);
      });
    });

    mobileNotesQuery.addEventListener('change', () => {
      const activeToggle = toggles.find((toggle) => toggle.getAttribute('aria-expanded') === 'true');
      if (activeToggle?.dataset.toolNotesToggle) setActivePanel(activeToggle.dataset.toolNotesToggle);
    });
  })();

  // ── Personal hero ASCII cat ──
  (function() {
    const el = document.getElementById('personalAsciiHero');
    if (!el) return;

    const dataEl = document.getElementById('personalCatAsciiData');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let frameData = { frames: [], delays: [] };
    try {
      frameData = JSON.parse(dataEl?.textContent || '{}');
    } catch (error) {
      frameData = { frames: [], delays: [] };
    }

    const catFrames = Array.isArray(frameData.frames) ? frameData.frames : [];
    const catDelays = Array.isArray(frameData.delays) ? frameData.delays : [];
    if (!catFrames.length) return;

    let frameIndex = 0;

    function render() {
      el.textContent = catFrames[frameIndex] || catFrames[0];
    }

    render();
    if (reduceMotion || catFrames.length < 2) return;

    function advance() {
      frameIndex = (frameIndex + 1) % catFrames.length;
      render();
      window.setTimeout(advance, catDelays[frameIndex] || 550);
    }

    window.setTimeout(advance, catDelays[0] || 550);
  })();

  // Tiny metaphorical animations for each tool type
  document.querySelectorAll('.tool-anim').forEach((canvas) => {
    const ctx = canvas.getContext('2d');
    const type = canvas.dataset.anim;
    const dpr = window.devicePixelRatio || 1;
    const w = canvas.width;
    const h = canvas.height;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    canvas.style.width = w + 'px';
    canvas.style.height = h + 'px';
    ctx.scale(dpr, dpr);

    function getColor(alpha) {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      return isDark ? `rgba(170,170,170,${alpha})` : `rgba(80,80,80,${alpha})`;
    }

    // Sift: particles falling, some drift left (rejected), some land right (kept)
    if (type === 'sift') {
      const particles = [];
      for (let i = 0; i < 14; i++) {
        particles.push({
          x: 8 + Math.random() * 32,
          y: Math.random() * h,
          speed: 0.15 + Math.random() * 0.25,
          keep: Math.random() < 0.3,
          phase: Math.random() * Math.PI * 2,
          size: 1 + Math.random() * 1.2,
        });
      }
      function draw() {
        ctx.clearRect(0, 0, w, h);
        for (const p of particles) {
          p.y += p.speed;
          if (p.y > h * 0.5 && !p.keep) p.x -= 0.12;
          if (p.y > h + 4) { p.y = -2; p.x = 8 + Math.random() * 32; }
          const alpha = p.keep ? 0.7 : Math.max(0, 0.5 - (p.y / h) * 0.5);
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
          ctx.fillStyle = getColor(alpha);
          ctx.fill();
        }
        requestAnimationFrame(draw);
      }
      draw();
    }

    // Hub: center dot with orbiting satellites connected by lines
    if (type === 'hub') {
      const satellites = [];
      for (let i = 0; i < 6; i++) {
        const angle = (i / 6) * Math.PI * 2;
        satellites.push({
          angle,
          dist: 8 + Math.random() * 5,
          speed: 0.2 + Math.random() * 0.3,
          size: 1 + Math.random() * 0.8,
        });
      }
      function draw() {
        const t = performance.now() * 0.001;
        ctx.clearRect(0, 0, w, h);
        const cx = w / 2, cy = h / 2;

        for (const s of satellites) {
          const a = s.angle + t * s.speed;
          const sx = cx + Math.cos(a) * s.dist;
          const sy = cy + Math.sin(a) * s.dist;
          ctx.beginPath();
          ctx.moveTo(cx, cy);
          ctx.lineTo(sx, sy);
          ctx.strokeStyle = getColor(0.25);
          ctx.lineWidth = 0.5;
          ctx.stroke();
          ctx.beginPath();
          ctx.arc(sx, sy, s.size, 0, Math.PI * 2);
          ctx.fillStyle = getColor(0.6);
          ctx.fill();
        }
        ctx.beginPath();
        ctx.arc(cx, cy, 2, 0, Math.PI * 2);
        ctx.fillStyle = getColor(0.8);
        ctx.fill();

        requestAnimationFrame(draw);
      }
      draw();
    }

    // Matrix: small grid of cells that light up in cross-validated patterns
    if (type === 'matrix') {
      const cols = 6, rows = 4;
      const cellW = (w - 8) / cols, cellH = (h - 4) / rows;
      function draw() {
        const t = performance.now() * 0.001;
        ctx.clearRect(0, 0, w, h);
        for (let r = 0; r < rows; r++) {
          for (let c = 0; c < cols; c++) {
            const val = Math.sin(t * 1.2 + c * 0.9 + r * 1.3) * 0.5 + 0.5;
            const x = 4 + c * cellW, y = 2 + r * cellH;
            ctx.fillStyle = getColor(0.08 + val * 0.45);
            ctx.fillRect(x + 0.5, y + 0.5, cellW - 1, cellH - 1);
          }
        }
        requestAnimationFrame(draw);
      }
      draw();
    }

    // Scan: dots in a grid with a spotlight sweeping across
    if (type === 'scan') {
      const dots = [];
      for (let r = 0; r < 4; r++) {
        for (let c = 0; c < 6; c++) {
          dots.push({ x: 6 + c * 7, y: 4 + r * 7, base: 0.15 });
        }
      }
      function draw() {
        const t = performance.now() * 0.001;
        ctx.clearRect(0, 0, w, h);
        const spotX = (Math.sin(t * 0.8) * 0.5 + 0.5) * w;
        const spotY = (Math.cos(t * 0.5) * 0.5 + 0.5) * h;
        for (const d of dots) {
          const dx = d.x - spotX, dy = d.y - spotY;
          const dist = Math.sqrt(dx * dx + dy * dy);
          const boost = Math.max(0, 1 - dist / 16);
          const alpha = d.base + boost * 0.65;
          const size = 1.2 + boost * 1.2;
          ctx.beginPath();
          ctx.arc(d.x, d.y, size, 0, Math.PI * 2);
          ctx.fillStyle = getColor(alpha);
          ctx.fill();
        }
        requestAnimationFrame(draw);
      }
      draw();
    }
  });

  // ── Animated ASCII hero background ──
  (function() {
    const el = document.getElementById('asciiHero');
    if (!el) return;

    function gabor(x, y, lambda, theta, sigma, phase) {
      const xp = x * Math.cos(theta) + y * Math.sin(theta);
      const yp = -x * Math.sin(theta) + y * Math.cos(theta);
      return Math.exp(-(xp * xp + yp * yp) / (2 * sigma * sigma))
           * Math.cos(2 * Math.PI * xp / lambda + phase);
    }

    const chars = ' .\u00b7:;+=*#%@';
    const cols = 38, rows = 14;
    const filters = [];
    for (let i = 0; i < 2; i++) {
      filters.push({
        theta: (i / 2) * Math.PI + Math.random() * 0.5,
        lambda: 3 + Math.random() * 3,
        sigma: 4 + Math.random() * 3,
        cx: cols * (0.3 + i * 0.4) + (Math.random() - 0.5) * 5,
        cy: rows * 0.5 + (Math.random() - 0.5) * 3,
        weight: 0.5 + Math.random() * 0.5,
        phaseSpeed: 0.2 + Math.random() * 0.3,
        driftSpeed: 0.05 + Math.random() * 0.08,
      });
    }

    let lastFrame = 0;
    function animate(now) {
      if (now - lastFrame > 50) {
        const t = now * 0.001;
        let out = '';
        for (let r = 0; r < rows; r++) {
          for (let c = 0; c < cols; c++) {
            let val = 0;
            for (const f of filters) {
              const x = (c - f.cx) * 0.3;
              const y = (r - f.cy) * 0.6;
              val += gabor(x, y, f.lambda, f.theta + Math.sin(t * f.driftSpeed) * 0.4,
                           f.sigma, t * f.phaseSpeed) * f.weight;
            }
            val = val / filters.length;
            const norm = Math.max(0, Math.min(1, (val + 1) / 2));
            out += chars[Math.floor(norm * (chars.length - 1))];
          }
          out += '\n';
        }
        el.textContent = out;
        lastFrame = now;
      }
      requestAnimationFrame(animate);
    }
    requestAnimationFrame(animate);
  })();
</script>
