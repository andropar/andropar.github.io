    flex-direction: column;
  }

  .personal-card--landscape .personal-card-media {
    aspect-ratio: var(--personal-card-media-ratio, 4 / 3);
    border-bottom: 1px solid var(--personal-card-border);
  }

  .personal-card--bouldering {
    --personal-card-media-ratio: 3 / 2;
  }

  .personal-card--meditation {
    --personal-card-media-ratio: 16 / 9;
  }

  .personal-card--side {
    display: grid;
    grid-template-columns: minmax(260px, 0.62fr) minmax(0, 1fr);
    align-items: stretch;
  }

  .personal-card--side .personal-card-media {
