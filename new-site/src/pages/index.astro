                    {coverRef ? (
                      <img src={openLibraryCover(coverRef)} alt={`${title} cover`} loading="lazy" decoding="async" fetchpriority="low" data-prefetch-book-cover />
                    ) : (
                      <span class="personal-book-card-placeholder" aria-hidden="true">
                        <span>{title}</span>
                        <small>{author}</small>
                      </span>
                    )}
                  </span>
                  <span class="personal-book-card-title">{title}</span>
                  <span class="personal-book-card-author">{author}</span>
                </article>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Personal: Notes -->
  <section class="section mode-section mode-section--personal" id="personal-notes">
    <div class="personal-section-heading">
