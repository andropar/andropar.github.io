---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import V2Layout from '../layouts/V2Layout.astro';
import { currentBooks, lovedBookGroups, okayBooks } from '../data/books';
import { postLinkProps } from '../data/posts';
import workPortrait from '../../public/v2/portrait-oxford-original-face.png';
import casualPortrait from '../../public/portrait-casual-hero.png';
import artAndFear from '../../public/v2/art-and-fear.jpg';
import mindIlluminated from '../../public/v2/the-mind-illuminated.jpg';
import bouldering from '../../public/personal/about-bouldering.webp';
import band from '../../public/personal/about-band.webp';
import food from '../../public/personal/about-good-food.webp';
import meditation from '../../public/personal/about-meditation.webp';

const posts = (await getCollection('blog')).filter(post => !post.data.draft).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featuredPosts = posts.slice(0, 2);
const dateLabel = (date: Date) => date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
const coverURL = (reference: string) => {
  const [kind, value] = reference.includes(':') ? reference.split(':') : ['isbn', reference];
  return `https://covers.openlibrary.org/b/${kind === 'id' ? 'id' : 'isbn'}/${value}-M.jpg`;
};
const currentCovers = [artAndFear, mindIlluminated];
// Writing thumbnails by post slug: a mask graphic drawn from the post's data, or an image. Posts
// without an entry show no thumbnail.
const postThumbs: Record<string, { graphic?: string; image?: ImageMetadata }> = {
  'a-century-of-fear': { graphic: 'century' },
  'what-vision-models-agree-on': { graphic: 'paper-universal' },
  its_always_clear_from_outside: { image: artAndFear },
};
// Selected work: each project feeds its tile (figure, title, summary, links) and its "More" dialog.
// `media` is a mask graphic (with optional hover or scrub data) or the ReLAION photo sheet.
const projects = [
  {
    id: 'horrorverse',
    title: 'Horrorverse',
    summary: 'A horror film recommender with mood search, an explorable map of the genre and an illustrated history.',
    media: { graphic: 'horrorverse', attrs: { 'data-hover': 'horrorverse' }, label: 'The Horrorverse atlas: horror films as dots arranged by theme and story, with the haunted-house region highlighted' },
    links: [{ label: 'Open Horrorverse', href: 'https://horrorverse.jroth.space/' }, { label: 'Movie night', href: 'https://horrorverse.jroth.space/app/movie-night' }],
    what: 'It started as a way to settle what to watch on our horror movie nights. Describe a mood, like slow-burn folk horror under 100 minutes, and it picks one to three films for the night. Rate a few films and the daily picks get better, or wander the atlas: about 20,700 films arranged by theme and story.',
    did: 'I built the recommender, trained on MovieLens 32M with a content bridge for films nobody has rated yet, plus the mood search on text embeddings, a movie-night chat where an LLM turns what you say into search settings (it never does the ranking), the atlas, Letterboxd import, accounts and the self-hosted deployment.',
    outcome: 'It\'s live, and we use it every movie night. Its catalogue also became the data behind <a href="/blog/a-century-of-fear">A century of fear</a>, an illustrated history of 19,302 horror films, each labelled by two Claude models and checked against Wikidata.',
  },
  {
    id: 'relaion',
    title: 'ReLAION-natural',
    summary: 'Naturalness scores for every image in ReLAION-2B, plus CLIP embeddings for the natural photos.',
    media: { photos: '/v2/graphics/relaion-photos.webp', label: 'A contact sheet of natural photographs from the dataset, one highlighted' },
    links: [{ label: 'View dataset', href: 'https://huggingface.co/datasets/andropar/relaion2b-natural' }, { label: 'CCN 2025 paper', href: 'https://openreview.net/forum?id=T9k6KkZoca' }],
    what: 'Web-scale image datasets mix photographs with screenshots, product shots, memes and text. ReLAION-natural scores all 2.1 billion images in ReLAION-2B for how natural they are, so you can pull out the roughly 500 million natural photographs.',
    did: 'I trained the naturalness classifier on CLIP embeddings, with about 26,000 images labelled through active learning, and built the GPU pipelines that scored the full dataset and extracted CLIP embeddings for the natural photos.',
    outcome: 'It\'s the image pool behind the CCN 2025 paper on sampling natural images and the natural photographs in LAION-fMRI. Together with its embeddings, it has been downloaded about 33,000 times on Hugging Face, currently around 3,800 a month.',
  },
  {
    id: 'laion-fmri',
    title: 'LAION-fMRI',
    summary: 'A deeply sampled fMRI dataset of natural images.',
    media: { graphic: 'laion', attrs: { 'data-scrub': 'laion-sprite', 'data-frames': '16' }, label: 'A sagittal brain slice drawn as contour lines, with face- and scene-selective cortex filled in' },
    links: [{ label: 'Explore project', href: 'https://laion-fmri.hebartlab.com/' }, { label: 'Brain explorer', href: 'https://laion-fmri.hebartlab.com/brain/' }],
    what: 'A 7T fMRI dataset in which five people each spent about 60 hours in the scanner looking at 25,052 natural images, many of them shown several times. It is built to cover far more of the visual world than earlier datasets: 2.5× the effective dimensionality of NSD and THINGS.',
    did: 'I designed the stimulus set and built the tools around the data: the Python package, the website, the 3D brain explorer and the AWS data access.',
    outcome: 'It launched at VSS 2026 and is freely available for research; the dataset paper is in preparation. It is also the dataset behind re:vision.',
  },
  {
    id: 'revision',
    title: 're:vision',
    summary: 'A community challenge testing whether findings in visual neuroscience replicate on LAION-fMRI.',
    media: { graphic: 'revision', attrs: { 'data-hover': 'revision' }, label: 'Brain-predictivity scores of 118 vision models, sorted, with the ten best highlighted' },
    links: [{ label: 'Explore project', href: 'https://re-vision-initiative.org/' }],
    what: 'Teams pick a published finding from visual neuroscience and test whether it replicates on LAION-fMRI\'s much broader set of images, and whether it generalizes. Every valid replication goes into a consortium paper, whatever the result.',
    did: 'I am one of the coordinators. I made the data splits, ran the benchmark replication of 118 vision models for the consortium paper, and built the website and data services.',
    outcome: 'It launched at VSS in May 2026, with prizes for the best replication and the best generalization. Reports are due in February 2027, and the synthesis paper follows later that year.',
  },
  {
    id: 'conwell',
    title: 'Conwell replication',
    summary: 'A replication on LAION-fMRI of a large study on which design choices make vision models brain-like.',
    media: { graphic: 'conwell', attrs: {}, label: 'For each controlled comparison in the original study, its effect as a ring beside the LAION-fMRI replication estimate with its interval' },
    links: [{ label: 'View on GitHub', href: 'https://github.com/andropar/conwell_replication' }, { label: 'Original study', href: 'https://doi.org/10.1038/s41467-024-53972-1' }],
    what: 'Conwell et al. (2024) compared a large survey of vision models against brain responses in NSD to ask which design choices, from architecture to training task and training data, make a model more brain-like. The replication asks whether those controlled comparisons hold on LAION-fMRI\'s much broader set of images.',
    did: 'I re-ran the study\'s own feature-extraction protocol on 118 models and five LAION-fMRI participants, reproduced its controlled comparisons of architecture, training task and training data, and added tests on out-of-distribution images.',
    outcome: 'It is the benchmark replication for the re:vision consortium paper. Some effects hold, like the advantage of contrastive self-supervised training; others shrink or flip.',
  },
  {
    id: 'thingsvision',
    title: 'thingsvision',
    summary: 'An open-source library for extracting and comparing features from vision models.',
    media: { graphic: 'thingsvision', attrs: { 'data-hover': 'thingsvision' }, label: 'A similarity matrix of ResNet-50 features for eight image categories, one category highlighted' },
    links: [{ label: 'View library', href: 'https://github.com/ViCCo-Group/thingsvision' }],
    what: 'Give it a folder of images and a vision model, and it returns the model\'s representation of every image, with tools to compare those representations to brains and behaviour. It supports models from torchvision, timm, OpenCLIP, Keras and more.',
    did: 'I am one of its main contributors: I added low-memory feature extraction, support for HDF5 datasets, and the tests that check every integrated model.',
    outcome: 'It\'s downloaded about 470 times a month from PyPI and has 179 stars on GitHub.',
  },
];
const tools = [
  { repo: 'voice-annotate', description: 'A macOS app: talk and draw on your screen, then paste the result into any coding agent.' },
  { repo: 'slurmboard', description: 'A lightweight dashboard for Slurm jobs, logs and resource use on HPC clusters.' },
  { repo: 'fmriqc', description: 'An interactive QA and review tool for fMRI data snapshots.' },
  { repo: 'cvmanova_python', description: 'Cross-validated MANOVA for multivariate fMRI pattern analysis.' },
  { repo: 'pysearchlight', description: 'Customisable searchlight analysis for Python.' },
  { repo: 'how-to-sample', description: 'Code and experiments for the CCN 2025 paper on sampling natural images.' },
];
const publications = [
  { year: '2026', title: 'Characterizing Universal Object Representations Across Vision Models', authors: 'Mahner*, Roth* et al.', venue: 'NeurIPS 2026 (accepted)', graphic: 'universal', graphicAlt: 'Dimensions of object-similarity structure in ten vision models, one row per model, placed by how consistently each recurs in the others; one shared dimension is traced across all models', href: 'https://arxiv.org/abs/2605.13675', note: 'Shared first author', summary: 'We compared the object similarity structure of 162 vision models to distinguish universal from model-specific dimensions, and related that structure to image properties, neural activity, and human judgments.' },
  { year: '2025', title: 'How to sample the world for understanding the visual system', authors: 'Roth & Hebart', venue: 'CCN', graphic: 'sampling', graphicAlt: 'Clusters of natural photographs in a t-SNE map, with the clusters that THINGS and NSD barely cover highlighted', href: 'https://openreview.net/forum?id=T9k6KkZoca', note: 'Oral', summary: 'How does the choice of images affect what we can learn about the visual brain? We compared image-sampling strategies using simulations and fMRI data to study dataset coverage and model generalization.' },
  { year: '2025', title: 'Ten principles for reliable, efficient, and adaptable coding in psychology and cognitive neuroscience', authors: 'Roth*, Duan* et al.', venue: 'Communications Psychology', graphic: 'coding', graphicAlt: 'Every commit to the LAION-fMRI package in order, lines added above the axis and deleted below, with commits that touched the tests highlighted', href: 'https://doi.org/10.1038/s44271-025-00236-3', award: 'CMBB Replication Award', summary: 'A practical guide to research software, covering project organization, testing, documentation, version control, and collaboration.' },
];
const roles = [
  { span: [2022.33, null], date: 'May 2022–present', title: 'PhD Researcher · Computational Cognitive Neuroscience', short: 'PhD · MPI CBS', organization: 'Max Planck Institute for Human Cognitive and Brain Sciences & University of Giessen', description: 'Independent research on vision models and human brain activity, with GPU-based data pipelines, fMRI experiments, and public research software.' },
  { span: [2021.42, 2022.33], date: 'Jun 2021–May 2022', title: 'Research Scientist · Machine Learning in Medicine', short: 'ScaDS.AI', organization: 'ScaDS.AI Dresden/Leipzig', description: 'Deep-learning models for brain-tumor segmentation and predictive models for clinical data, including mortality prediction and uncertainty estimation.' },
  { span: [2019.83, 2021.33], date: 'Nov 2019–May 2021', title: 'Data Scientist / ML Engineer · Working student', short: 'CHECK24', organization: 'CHECK24, Travel Vertical', description: 'Designed and deployed a production computer-vision service for 20 million hotel images. Improved recommendation-data pipelines, reducing update time by over 95%.' },
  { span: [2020.75, 2021.33], date: 'Oct 2020–May 2021', title: 'Full-Stack Developer · Freelance', short: 'Kimetric · freelance', organization: 'Kimetric UG', description: 'Delivered Django websites for Hebart Lab and the THINGS Initiative, from client requirements to deployment, Linux hosting, and maintenance.' },
  { span: [2018.75, 2019.67], date: 'Oct 2018–Sep 2019', title: 'Data Scientist · Working student', short: 'Webdata Solutions', organization: 'Webdata Solutions GmbH (now Vistex)', description: 'Developed machine-learning models for product matching and image classification in e-commerce, raising image-based matching accuracy from 12% to 83%.' },
  { span: [2018.08, 2018.58], date: 'Feb 2018–Aug 2018', title: 'Data Analyst · Working student', short: 'Mercateo', organization: 'Mercateo Services GmbH & Co. KG', description: 'Data integration, reporting, and testing for an AWS-based data warehouse using Apache NiFi and Pentaho.' },
];
const education = [
  { span: [2022.33, null], date: 'May 2022–present', title: 'Doctoral candidate · Dr. rer. nat.', organization: 'University of Giessen', description: 'Research focus: machine learning and computational neuroscience.' },
  { span: [2017.75, 2021.42], date: '2017–2021', title: 'M.Sc. Computer Science', short: 'M.Sc. · Leipzig', organization: 'Leipzig University · Grade 1.2', description: 'Master’s thesis: generative deep learning for visual processing in the human brain (grade 1.1).' },
  { span: [2014.75, 2017.75], date: '2014–2017', title: 'B.Sc. Business Information Systems', short: 'B.Sc. · Leipzig', organization: 'Leipzig University · Grade 1.5', description: '' },
];
// Role and degree spans share one scale, so the bars in the date column are comparable.
const now = new Date();
const timelineStart = 2014;
const timelineEnd = now.getFullYear() + now.getMonth() / 12;
const spanStyle = ([from, to]: (number | null)[]) => {
  const scale = (year: number) => ((year - timelineStart) / (timelineEnd - timelineStart)) * 100;
  return `--from: ${scale(from!).toFixed(1)}%; --to: ${scale(to ?? timelineEnd).toFixed(1)}%`;
};
// The CV timeline: every role and degree as a bar on that scale, with a tick every two years.
const timelineRows = [
  ...roles.map(role => ({ label: role.short, span: role.span, edu: false })),
  ...education.filter(degree => degree.short).map(degree => ({ label: degree.short, span: degree.span, edu: true })),
];
const timelineTicks = [2014, 2016, 2018, 2020, 2022, 2024, 2026].map(year => ({ year, at: ((year - timelineStart) / (timelineEnd - timelineStart)) * 100 }));
const lifeStories = [
  { title: 'Movement', image: bouldering, position: '35% 50%', alt: 'Johannes bouldering on a rock face in a mountain valley', copy: 'My love for moving my body started with joining a breakdance crew at 17. These days I mostly boulder, lift weights, and do yoga. A day in the mountains with some climbing is hard to beat.' },
  { title: 'Music', image: band, position: '50% 30%', alt: 'Johannes holding an electric guitar', copy: 'A few years ago, I asked some friends if they wanted to start a band. Everyone said yes. We mostly play pop punk covers at birthday parties, but the dream of writing our own songs is still alive.' },
  { title: 'Food', image: food, position: '50% 50%', alt: 'A colorful plate of food on a wooden table', copy: 'I used to be an incredibly picky eater. Now I love throwing whole food ingredients together and having friends over for dinner. Hosting is a blast, even when it gets surprisingly stressful.' },
  { title: 'Meditation', image: meditation, position: '50% 50%', alt: 'A quiet forest path near the meditation hall', copy: 'Meditation and I have had an on-off relationship for over a decade. A ten-day silent retreat in 2024 changed a lot for me. I walked this forest path probably a hundred times and kept discovering something new.' },
];
---
<V2Layout title="Johannes Roth — Machine Learning & Research" wide>
  <div data-view="work" id="work">
    <section class="hero" aria-labelledby="work-title">
      <div class="hero-body">
        <h1 id="work-title" tabindex="-1">Johannes Roth</h1>
        <p class="hero-lede">Machine learning engineer & PhD researcher.</p>
        <p class="hero-text">At the Max Planck Institute in Leipzig, I work on vision models and the brain. Before that, I did machine learning at ScaDS.AI and CHECK24.</p>
        <div class="hero-actions">
          <a class="button button--primary" href="#selected-work">Explore my work</a>
          <a class="button" href="#contact">Get in touch</a>
        </div>
        <p class="meta status">Available from January 2027</p>
      </div>
      <div class="frame hero-portrait">
        <Image src={workPortrait} alt="Johannes Roth smiling, in a light blue Oxford shirt with rolled sleeves and his arms crossed" widths={[320, 640, 960]} sizes="(max-width: 600px) 22rem, 17rem" width={640} format="webp" loading="eager" fetchpriority="high" />
      </div>
    </section>

    <div class="work-band">
      <section class="panel panel--band" id="selected-work" aria-labelledby="work-heading">
        <div class="panel-head">
          <h2 id="work-heading">Selected work</h2>
        </div>
        <section class="work-group" id="projects" aria-labelledby="projects-heading">
          <div class="group-head">
            <h3 id="projects-heading">Projects</h3>
            <a class="link" href="https://github.com/andropar" target="_blank" rel="noopener">GitHub</a>
          </div>
          <div class="tiles tiles--work">
            {projects.map(project => (
              <article class="card tile">
                {project.media.photos
                  ? <div class="frame tile-media tile-media--photos"><img src={project.media.photos} alt={project.media.label} width="1240" height="712" loading="lazy" decoding="async" /></div>
                  : <div class={`frame tile-media graphic graphic--${project.media.graphic}`} {...project.media.attrs} role="img" aria-label={project.media.label}><span class="graphic-ink"></span><span class="graphic-accent"></span></div>}
                <h4>{project.title}</h4>
                <p class="card-text">{project.summary}</p>
                <div class="item-links">
                  <a class="link stretched" href={project.links[0].href} target="_blank" rel="noopener">{project.links[0].label}</a>
                  <button class="link more-button" type="button" data-dialog={`project-${project.id}`} aria-haspopup="dialog">More</button>
                </div>
              </article>
            ))}
          </div>
        </section>
        <section class="work-group" id="research" aria-labelledby="research-heading">
          <div class="group-head">
            <h3 id="research-heading">Publications</h3>
            <a class="link" href="https://scholar.google.com/citations?user=U3Z3J2gAAAAJ" target="_blank" rel="noopener">Google Scholar</a>
          </div>
          <div class="items items--cols">
            {publications.map(paper => (
              <article class="card item">
                <div class={`frame item-media graphic graphic--paper-${paper.graphic}`} role="img" aria-label={paper.graphicAlt}><span class="graphic-ink"></span><span class="graphic-accent"></span></div>
                {paper.award && <span class="award-badge" tabindex="0" role="img" aria-label={paper.award} data-tip={paper.award}><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 3h10v6a5 5 0 0 1-10 0V3ZM7 5H4v2a4 4 0 0 0 4 4m9-6h3v2a4 4 0 0 1-4 4M12 14v6m-4 1h8" /></svg></span>}
                <div class="item-head">
                  <p class="venue"><b>{paper.venue.replace(' (accepted)', '')}</b>{!paper.venue.includes(paper.year) && ` ${paper.year}`}{paper.note && <> · {paper.note}</>}</p>
                  <h4><a class="stretched" href={paper.href} target="_blank" rel="noopener">{paper.title}</a></h4>
                  <p class="card-detail">{paper.authors}</p>
                </div>
                <p class="card-text">{paper.summary}</p>
              </article>
            ))}
          </div>
        </section>
        <div class="work-pair">
          <section class="work-group" id="tools" aria-labelledby="tools-heading">
            <div class="group-head">
              <h3 id="tools-heading">Open-source tools</h3>
              <a class="link" href="https://github.com/andropar" target="_blank" rel="noopener">GitHub</a>
            </div>
            <ul class="mini mini--cols mini--icons">
              {tools.map(tool => (
                <li>
                  <span class="frame tool-icon graphic" aria-hidden="true" style={`--ink-mask: url(/v2/graphics/tool-${tool.repo}-ink.png); --accent-mask: url(/v2/graphics/tool-${tool.repo}-accent.png)`}><span class="graphic-ink"></span><span class="graphic-accent"></span></span>
                  <div>
                    <a class="link" href={`https://github.com/andropar/${tool.repo}`} target="_blank" rel="noopener">{tool.repo}</a>
                    <p>{tool.description}</p>
                  </div>
                </li>
              ))}
            </ul>
          </section>
          <section class="work-group" id="writing" aria-labelledby="writing-heading">
            <div class="group-head">
              <h3 id="writing-heading">Writing</h3>
              <a class="link" href="/blog">All writing</a>
            </div>
            <ul class="posts">
              {featuredPosts.map(post => {
                const thumb = postThumbs[post.slug];
                return (
                  <li class="post">
                    {thumb?.graphic && <span class={`frame post-thumb graphic graphic--${thumb.graphic}`} aria-hidden="true"><span class="graphic-ink"></span><span class="graphic-accent"></span></span>}
                    {thumb?.image && <span class="frame post-thumb post-thumb--cover"><Image src={thumb.image} alt="" widths={[96, 192]} sizes="3rem" width={192} format="webp" loading="lazy" /></span>}
                    <div>
                      <time class="entry-meta" datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time>
                      <h4 class="entry-title"><a class="stretched" {...postLinkProps(post)}>{post.data.title}</a></h4>
                      <p class="entry-text">{post.data.description}</p>
                    </div>
                  </li>
                );
              })}
            </ul>
          </section>
        </div>
      </section>
    </div>

    <div class="dense dense--work">
      <section class="panel" id="experience" aria-labelledby="experience-heading">
        <div class="panel-head">
          <h2 id="experience-heading">Experience & education</h2>
          <a class="link" href="/cv.pdf">Full CV</a>
        </div>
        <div class="exp-top">
          <div class="exp-chart">
            <div class="group-head"><h3>Timeline</h3></div>
            <div class="timeline" role="img" aria-label="Roles and degrees from 2014 to now as bars on one time axis">
              <ol class="tl-rows">
                {timelineRows.map(row => (
                  <li class:list={['tl-row', { 'tl-row--edu': row.edu, 'tl-row--current': !row.span[1] }]} style={spanStyle(row.span)}>
                    <span class="tl-label">{row.label}</span>
                    <span class="tl-track"><span class="tl-bar"></span></span>
                  </li>
                ))}
              </ol>
              <div class="tl-axis"><span></span><span class="tl-ticks">{timelineTicks.map(tick => <span style={`--at: ${tick.at.toFixed(1)}%`}>{tick.year}</span>)}</span></div>
            </div>
          </div>
          <div class="exp-edu">
            <div class="group-head"><h3 id="education">Education</h3></div>
            <ul class="entries entries--edu">
              {education.map(degree => (
                <li class="entry">
                  <span class="entry-meta">{degree.date}</span>
                  <div>
                    <h3 class="entry-title">{degree.title}</h3>
                    <p class="entry-text entry-org">{degree.organization}</p>
                    {degree.description && <p class="entry-text">{degree.description}</p>}
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </div>
        <div class="group-head exp-roles-head"><h3>Roles</h3></div>
        <ul class="entries entries--cols entries--thirds">
          {roles.map(role => (
            <li class="entry">
              <span class="entry-meta">{role.date}</span>
              <div>
                <h3 class="entry-title">{role.title}</h3>
                <p class="entry-text entry-org">{role.organization}</p>
                <p class="entry-text">{role.description}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>
      <section class="panel panel--life" aria-labelledby="life-teaser-heading">
        <div class="panel-head">
          <h2 id="life-teaser-heading">Life outside work</h2>
        </div>
        <div class="life-band">
          <div class="life-band-text">
            <p>Climbing, making music, books, and dinner with friends.</p>
            <a class="link stretched" href="#life">Meet the other side of me</a>
          </div>
          {lifeStories.map(story => (
            <figure class="life-band-photo">
              <div class="frame">
                <Image class="photo-grade" src={story.image} alt={story.alt} widths={[300, 600]} sizes="(max-width: 720px) 45vw, 16rem" width={600} format="webp" loading="lazy" style={`object-position: ${story.position}`} />
              </div>
              <figcaption>{story.title}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    </div>
  </div>

  <div data-view="life" id="life">
    <section class="hero" aria-labelledby="life-title">
      <div class="hero-body">
        <h1 id="life-title" tabindex="-1">Still Johannes.</h1>
        <p class="hero-lede">A little less formal.</p>
        <p class="hero-text">Here's what life looks like away from the screen: climbing, making music, reading, and having friends over for dinner.</p>
        <div class="hero-actions">
          <a class="button button--primary" href="#life-about">A bit about me</a>
          <a class="button" href="#work">Back to work</a>
        </div>
      </div>
      <div class="frame hero-portrait">
        <Image src={casualPortrait} alt="Johannes smiling in a T-shirt and climbing harness" widths={[320, 640, 960]} sizes="(max-width: 600px) 22rem, 17rem" width={640} format="webp" loading="eager" />
      </div>
    </section>

    <div class="dense dense--life">
        <section class="panel" id="life-about" aria-labelledby="life-about-heading">
          <div class="panel-head">
            <h2 id="life-about-heading">A bit about me</h2>
          </div>
          <div class="stories stories--band">
            {lifeStories.map(story => (
              <article class="story item">
                <div class="frame item-media story-media">
                  <Image class="photo-grade" src={story.image} alt={story.alt} widths={[300, 600]} sizes="(max-width: 600px) 6.5rem, 20rem" width={600} format="webp" loading="lazy" style={`object-position: ${story.position}`} />
                </div>
                <div>
                  <h3>{story.title}</h3>
                  <p>{story.copy}</p>
                </div>
              </article>
            ))}
          </div>
        </section>


        <section class="panel panel--third" aria-labelledby="music-heading">
          <div class="panel-head">
            <h2 id="music-heading">Music</h2>
          </div>
          <div class="shelf-note">
            <p class="card-text">I listen to a bit of everything. Spotify probably knows my taste better than I do.</p>
            <div class="frame shelf-media">
              <iframe
                title="Johannes Roth Discover Weekly playlist"
                src="https://open.spotify.com/embed/playlist/37i9dQZEVXcKBQMbsgdSz3?utm_source=generator&theme=0"
                width="100%"
                height="152"
                allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                allowfullscreen
                loading="lazy"
              ></iframe>
            </div>
            <div class="link-row">
              <a class="link" href="https://open.spotify.com/playlist/37i9dQZEVXcKBQMbsgdSz3" target="_blank" rel="noopener">My Discover Weekly</a>
            </div>
          </div>
        </section>

        <section class="panel panel--third" aria-labelledby="movies-heading">
          <div class="panel-head">
            <h2 id="movies-heading">Horror movie night</h2>
          </div>
          <div class="shelf-note">
            <p class="card-text">My wife and I watch horror movies with friends. I built a little recommender to help us choose.</p>
            <div class="frame shelf-media graphic graphic--horrorverse" data-hover="horrorverse" role="img" aria-label="The Horrorverse atlas of horror films, with the haunted-house region highlighted"><span class="graphic-ink"></span><span class="graphic-accent"></span></div>
            <div class="link-row">
              <a class="link" href="https://horrorverse.jroth.space/app/movie-night" target="_blank" rel="noopener">Find our next movie</a>
              <a class="link" href="https://letterboxd.com/haukeman/" target="_blank" rel="noopener">My Letterboxd</a>
            </div>
          </div>
        </section>

        <section class="panel panel--third" id="life-notes" aria-labelledby="life-notes-heading">
          <div class="panel-head">
            <h2 id="life-notes-heading">Writing</h2>
            <a class="link" href="/blog">All writing</a>
          </div>
          <ul class="posts">
            {featuredPosts.map(post => {
              const thumb = postThumbs[post.slug];
              return (
                <li class="post">
                  {thumb?.graphic && <span class={`frame post-thumb graphic graphic--${thumb.graphic}`} aria-hidden="true"><span class="graphic-ink"></span><span class="graphic-accent"></span></span>}
                  {thumb?.image && <span class="frame post-thumb post-thumb--cover"><Image src={thumb.image} alt="" widths={[96, 192]} sizes="3rem" width={192} format="webp" loading="lazy" /></span>}
                  <div>
                    <time class="entry-meta" datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time>
                    <h3 class="entry-title"><a class="stretched" {...postLinkProps(post)}>{post.data.title}</a></h3>
                    <p class="entry-text">{post.data.description}</p>
                  </div>
                </li>
              );
            })}
          </ul>
        </section>

        <section class="panel" id="life-shelves" aria-labelledby="shelves-heading">
          <div class="panel-head">
            <h2 id="shelves-heading">On my shelves</h2>
            <span class="count">{lovedBookGroups.reduce((n, group) => n + group.books.length, 0)} loved books</span>
          </div>
          <div class="cover-wall">
            <div class="cover-row">
              <h4>Reading now</h4>
              <ul class="covers">
                {currentBooks.map((book, i) => (
                  <li class="cover cover--current" title={`${book.title} · ${book.author}`}>
                    <Image src={currentCovers[i]} alt={`${book.title} by ${book.author}`} widths={[96, 144]} sizes="3rem" width={144} format="webp" loading="lazy" />
                  </li>
                ))}
              </ul>
            </div>
            <div class="cover-row">
              <h4>Loved</h4>
              <ul class="covers covers--dense">
                {lovedBookGroups.flatMap(group => group.books.map(([title, author, ref]) => (
                  <li class="cover" title={`${title} · ${author} · ${group.label}`}>
                    {ref ? <img src={coverURL(ref)} alt={`${title} by ${author}`} width="80" height="120" loading="lazy" decoding="async" /> : <span class="cover-placeholder">{title}</span>}
                  </li>
                )))}
              </ul>
            </div>
          </div>
          <details class="disclosure book-archive">
            <summary>Books I found okay</summary>
            <div class="book-archive-body">
              <ul class="book-grid">
                {okayBooks.map(([title, author, ref]) => (
                  <li class="archive-book">
                    <img src={coverURL(ref)} alt={`${title} cover`} width="90" height="132" loading="lazy" decoding="async" />
                    <div><p class="archive-title">{title}</p><p class="meta">{author}</p></div>
                  </li>
                ))}
              </ul>
            </div>
          </details>
        </section>
    </div>
  </div>

  {projects.map((project, i) => (
    <dialog class="project-dialog" id={`project-${project.id}`} aria-labelledby={`project-${project.id}-title`} style={`--tc: var(--p${(i % 4) + 1})`}>
      <button class="icon-button project-dialog-close" type="button" aria-label="Close">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
      {project.media.photos
        ? <div class="frame project-dialog-media tile-media--photos"><img src={project.media.photos} alt={project.media.label} width="1240" height="712" loading="lazy" decoding="async" /></div>
        : <div class={`frame project-dialog-media graphic graphic--${project.media.graphic}`} {...project.media.attrs} role="img" aria-label={project.media.label}><span class="graphic-ink"></span><span class="graphic-accent"></span></div>}
      <div class="project-dialog-body">
        <h2 id={`project-${project.id}-title`}>{project.title}</h2>
        <p class="project-dialog-lede">{project.summary}</p>
        <div class="project-facts">
          <section><h3>What it is</h3><p>{project.what}</p></section>
          <section><h3>What I did</h3><p>{project.did}</p></section>
          <section><h3>What came out of it</h3><p set:html={project.outcome} /></section>
        </div>
        <div class="item-links">
          {project.links.map(link => <a class="link" href={link.href} target="_blank" rel="noopener">{link.label}</a>)}
        </div>
      </div>
    </dialog>
  ))}

  <section class="contact-strip" id="contact" aria-labelledby="contact-heading">
    <div class="panel-head">
      <h2 id="contact-heading">Say hi</h2>
    </div>
    <div class="contact-row">
      <a class="contact-email" href="mailto:johannes@roth24.de">johannes@roth24.de</a>
      <p class="meta">For research, collaborations, or a good conversation.</p>
      <p class="meta status">Available from January 2027</p>
      <ul class="link-row contact-links">
        <li><a class="link" href="https://github.com/andropar" target="_blank" rel="noopener">GitHub</a></li>
        <li><a class="link" href="https://linkedin.com/in/johannes-roth-a67baa141" target="_blank" rel="noopener">LinkedIn</a></li>
        <li><a class="link" href="https://huggingface.co/andropar" target="_blank" rel="noopener">Hugging Face</a></li>
        <li><a class="link" href="https://scholar.google.com/citations?user=U3Z3J2gAAAAJ" target="_blank" rel="noopener">Google Scholar</a></li>
      </ul>
    </div>
  </section>
</V2Layout>

<script>
  import '../scripts/graphics';
  import '../scripts/project-dialogs';
</script>
