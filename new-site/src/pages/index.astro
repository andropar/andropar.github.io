---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import V2Layout from '../layouts/V2Layout.astro';
import { currentBooks, lovedBookGroups, okayBooks } from '../data/books';
import workPortrait from '../../public/v2/portrait-oxford-original-face.png';
import casualPortrait from '../../public/portrait-casual-hero.png';
import relaionExamples from '../../public/v2/relaion-examples.png';
import revisionLogo from '../../public/v2/revision-logo.png';
import laionMosaic from '../../public/v2/laion-fmri-mosaic.png';
import artAndFear from '../../public/v2/art-and-fear.jpg';
import mindIlluminated from '../../public/v2/the-mind-illuminated.jpg';
import bouldering from '../../public/personal/about-bouldering.webp';
import band from '../../public/personal/about-band.webp';
import food from '../../public/personal/about-good-food.webp';
import meditation from '../../public/personal/about-meditation.webp';

const posts = (await getCollection('blog')).filter(post => !post.data.draft).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featuredPosts = posts.slice(0, 2);
const dateLabel = (date: Date) => date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
const coverURL = (reference: string) => {
  const [kind, value] = reference.includes(':') ? reference.split(':') : ['isbn', reference];
  return `https://covers.openlibrary.org/b/${kind === 'id' ? 'id' : 'isbn'}/${value}-M.jpg`;
};
const currentCovers = [artAndFear, mindIlluminated];
const thingsvisionSample = `from thingsvision import get_extractor

extractor = get_extractor(
    model_name="alexnet",
    source="torchvision",
    device="cuda",
    pretrained=True,
)`;
const focusAreas = [
  { title: 'Machine learning & data science', description: 'Building models and using data to understand patterns, make predictions, and support decisions.' },
  { title: 'Production ML systems', description: 'Making ML systems reliable, efficient, and maintainable in everyday use.' },
  { title: 'Data engineering', description: 'Making data accessible, consistent, and useful for analysis and applications.' },
  { title: 'Backend & web development', description: 'Building useful applications and services with clear interfaces and maintainable architecture.' },
  { title: 'Research & experimental design', description: 'Turning open questions into testable ideas, sound experiments, and clear conclusions.' },
  { title: 'Project ownership & collaboration', description: 'Shaping the work, coordinating with others, and seeing projects through.' },
];
const publications = [
  { year: '2026', title: 'Characterizing Universal Object Representations Across Vision Models', authors: 'Mahner*, Roth* et al.', venue: 'NeurIPS 2026 (accepted)', href: 'https://arxiv.org/abs/2605.13675', note: 'Shared first author', summary: 'We compared the object similarity structure of 162 vision models to distinguish universal from model-specific dimensions, and related that structure to image properties, neural activity, and human judgments.' },
  { year: '2025', title: 'How to sample the world for understanding the visual system', authors: 'Roth & Hebart', venue: 'CCN', href: 'https://openreview.net/forum?id=T9k6KkZoca', note: 'Oral', summary: 'How does the choice of images affect what we can learn about the visual brain? We compared image-sampling strategies using simulations and fMRI data to study dataset coverage and model generalization.' },
  { year: '2025', title: 'Ten principles for reliable, efficient, and adaptable coding in psychology and cognitive neuroscience', authors: 'Roth*, Duan* et al.', venue: 'Communications Psychology', href: 'https://doi.org/10.1038/s44271-025-00236-3', note: 'Shared first author', award: 'CMBB Replication Award · 2025', summary: 'A practical guide to research software, covering project organization, testing, documentation, version control, and collaboration.' },
  { year: '2025', title: 'Fine-grained image and category information in ventral visual pathway', authors: 'Badwal, Bergmann, Roth et al.', venue: 'J Neuroscience', href: 'https://doi.org/10.1523/JNEUROSCI.0936-24.2024' },
];
const olderPublications = [
  { year: '2023', title: 'High stimulus presentation rates for fMRI', authors: 'Roth, Miyawaki & Hebart', venue: 'VSS poster', href: 'https://jov.arvojournals.org/article.aspx?articleid=2791453' },
  { year: '2022', title: 'Multi-plane UNet++ Ensemble for Glioblastoma Segmentation', authors: 'Roth et al.', venue: 'MICCAI BrainLes 2021 proceedings', href: 'https://doi.org/10.1007/978-3-031-08999-2_23' },
  { year: '2021', title: 'Preferred stimuli for individual voxels in the human visual system', authors: 'Roth, Seeliger, Schmid & Hebart', venue: 'Cosyne poster', href: 'https://jov.arvojournals.org/article.aspx?articleid=2777378' },
];
const roles = [
  { date: 'May 2022–present', title: 'PhD Researcher · Computational Cognitive Neuroscience', organization: 'Max Planck Institute for Human Cognitive and Brain Sciences & University of Giessen', description: 'Independent research on vision models and human brain activity, with GPU-based data pipelines, fMRI experiments, and public research software.' },
  { date: 'Jun 2021–May 2022', title: 'Research Scientist · Machine Learning in Medicine', organization: 'ScaDS.AI Dresden/Leipzig', description: 'Deep-learning models for brain-tumor segmentation and predictive models for clinical data, including mortality prediction and uncertainty estimation.' },
  { date: 'Nov 2019–May 2021', title: 'Data Scientist / ML Engineer · Working student', organization: 'CHECK24, Travel Vertical', description: 'Designed and deployed a production computer-vision service for 20 million hotel images. Improved recommendation-data pipelines, reducing update time by over 95%.' },
  { date: 'Oct 2020–May 2021', title: 'Full-Stack Developer · Freelance', organization: 'Kimetric UG', description: 'Delivered Django websites for Hebart Lab and the THINGS Initiative, from client requirements to deployment, Linux hosting, and maintenance.' },
  { date: 'Oct 2018–Sep 2019', title: 'Data Scientist · Working student', organization: 'Webdata Solutions GmbH (now Vistex)', description: 'Developed machine-learning models for product matching and image classification in e-commerce.' },
  { date: 'Feb 2018–Aug 2018', title: 'Data Analyst · Working student', organization: 'Mercateo Services GmbH & Co. KG', description: 'Data integration, reporting, and testing for an AWS-based data warehouse using Apache NiFi and Pentaho.' },
];
const education = [
  { date: 'May 2022–present', title: 'Doctoral candidate · Dr. rer. nat.', organization: 'University of Giessen', description: 'Research focus: machine learning and computational neuroscience.' },
  { date: '2017–2021', title: 'M.Sc. Computer Science', organization: 'Leipzig University · Grade 1.2', description: 'Master’s thesis: generative deep learning for visual processing in the human brain (grade 1.1).' },
  { date: '2014–2017', title: 'B.Sc. Business Information Systems', organization: 'Leipzig University · Grade 1.5', description: '' },
];
const lifeStories = [
  { title: 'Movement', image: bouldering, position: '35% 50%', alt: 'Johannes bouldering on a rock face in a mountain valley', copy: 'My love for moving my body started with joining a breakdance crew at 17. These days I mostly boulder, lift weights, and do yoga. A day in the mountains with some climbing is hard to beat.' },
  { title: 'Music', image: band, position: '50% 30%', alt: 'Johannes holding an electric guitar', copy: 'A few years ago, I asked some friends if they wanted to start a band. Everyone said yes. We mostly play pop punk covers at birthday parties, but the dream of writing our own songs is still alive.' },
  { title: 'Food', image: food, position: '50% 50%', alt: 'A colorful plate of food on a wooden table', copy: 'I used to be an incredibly picky eater. Now I love throwing whole food ingredients together and having friends over for dinner. Hosting is a blast, even when it gets surprisingly stressful.' },
  { title: 'Meditation', image: meditation, position: '50% 50%', alt: 'A quiet forest path near the meditation hall', copy: 'Meditation and I have had an on-off relationship for over a decade. A ten-day silent retreat in 2024 changed a lot for me. I walked this forest path probably a hundred times and kept discovering something new.' },
];
---

<V2Layout title="Johannes Roth — Machine Learning & Research">
  <div data-view="work" id="work">
    <section class="hero" aria-labelledby="work-title">
      <div class="hero-body">
        <h1 id="work-title" tabindex="-1">Johannes Roth</h1>
        <p class="hero-lede">Machine learning engineer & PhD researcher.</p>
        <p class="hero-text">I build computer-vision systems, data pipelines, and software for research. I study how vision models relate to human brain activity.</p>
        <div class="hero-actions">
          <a class="button button--primary" href="#selected-work">Explore my work</a>
          <a class="button" href="#contact">Get in touch</a>
        </div>
        <p class="meta status">Available from January 2027</p>
      </div>
      <div class="frame hero-portrait">
        <Image src={workPortrait} alt="Johannes Roth smiling, in a light blue Oxford shirt with rolled sleeves and his arms crossed" widths={[320, 640, 960]} sizes="(max-width: 600px) 22rem, 18rem" width={640} format="webp" loading="eager" fetchpriority="high" />
      </div>
    </section>

    <section class="section" id="selected-work" aria-labelledby="work-heading">
      <div class="section-head">
        <h2 id="work-heading">Selected work</h2>
        <a class="link" href="https://github.com/andropar" target="_blank" rel="noopener">More on GitHub</a>
      </div>
      <div class="card-grid card-grid--projects">
        <article class="card">
          <div class="frame card-media">
            <Image src={relaionExamples} alt="Example photographs from ReLAION-natural: interiors, furniture, people, and outdoor scenes" widths={[480, 900]} sizes="(max-width: 720px) 90vw, 444px" width={900} format="webp" loading="lazy" />
          </div>
          <h3>ReLAION-natural</h3>
          <p class="card-text">Naturalistic images and embeddings for vision research.</p>
          <p class="card-detail">I developed pipelines for image classification, quality checks, and feature extraction to curate the dataset.</p>
          <div class="card-footer">
            <p class="meta">Dataset curation · Feature extraction</p>
            <a class="link stretched" href="https://huggingface.co/datasets/andropar/relaion2b-natural" target="_blank" rel="noopener">View dataset</a>
          </div>
        </article>
        <article class="card">
          <div class="frame card-media card-media--revision" aria-hidden="true">
            <Image src={revisionLogo} alt="" widths={[180, 360]} sizes="7rem" width={180} format="webp" loading="lazy" />
            <span>re:vision</span>
          </div>
          <h3>re:vision</h3>
          <p class="card-text">Website, data services, and annotation tools for a replication initiative.</p>
          <p class="card-detail">I developed the website, data services, and annotation tools, and contributed to preprocessing and documentation. I also helped design dataset splits for training and evaluating models.</p>
          <div class="card-footer">
            <p class="meta">Research software · Model evaluation</p>
            <a class="link stretched" href="https://re-vision-initiative.org/" target="_blank" rel="noopener">Explore project</a>
          </div>
        </article>
        <article class="card">
          <div class="frame card-media card-media--mark">
            <Image src={laionMosaic} alt="LAION-fMRI wordmark assembled from natural image thumbnails" widths={[480, 800]} sizes="(max-width: 720px) 90vw, 380px" width={800} format="webp" loading="lazy" />
          </div>
          <h3>LAION-fMRI</h3>
          <p class="card-text">A public brain-imaging dataset for visual neuroscience.</p>
          <p class="card-detail">I built the website and cloud-based download services. I also helped preprocess the data and develop a framework for selecting experimental stimuli.</p>
          <div class="card-footer">
            <p class="meta">Data services · Experimental design</p>
            <a class="link stretched" href="https://laion-fmri.hebartlab.com/" target="_blank" rel="noopener">Explore project</a>
          </div>
        </article>
        <article class="card">
          <div class="frame card-media card-media--code">
            <pre><code>{thingsvisionSample}</code></pre>
          </div>
          <h3>thingsvision</h3>
          <p class="card-text">A common interface for extracting and comparing vision-model features.</p>
          <p class="card-detail">I contributed to the software architecture, model integration, and memory efficiency.</p>
          <div class="card-footer">
            <p class="meta">Contributor · Python</p>
            <a class="link stretched" href="https://github.com/ViCCo-Group/thingsvision" target="_blank" rel="noopener">View library</a>
          </div>
        </article>
      </div>
    </section>

    <section class="section" id="capabilities" aria-labelledby="capabilities-heading">
      <div class="section-head">
        <h2 id="capabilities-heading">Expertise</h2>
      </div>
      <dl class="focus-grid">
        {focusAreas.map(area => <div><dt>{area.title}</dt><dd>{area.description}</dd></div>)}
      </dl>
    </section>

    <section class="section" id="research" aria-labelledby="research-heading">
      <div class="section-head">
        <h2 id="research-heading">Research & publications</h2>
        <a class="link" href="https://scholar.google.com/citations?user=U3Z3J2gAAAAJ" target="_blank" rel="noopener">Google Scholar</a>
        <p class="section-lede">At the Max Planck Institute and University of Giessen, I study how visual representations in models relate to the human brain.</p>
      </div>
      <ul class="entries">
        {publications.map(paper => (
          <li class="entry">
            <span class="entry-meta">{paper.year}</span>
            <div>
              <h3 class="entry-title"><a href={paper.href} target="_blank" rel="noopener">{paper.title}</a></h3>
              <p class="entry-text">{paper.authors} · {paper.venue}{paper.note && <> · <span class="entry-note">{paper.note}</span></>}</p>
              {paper.award && <p class="award-note"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M7 3h10v6a5 5 0 0 1-10 0V3ZM7 5H4v2a4 4 0 0 0 4 4m9-6h3v2a4 4 0 0 1-4 4M12 14v6m-4 1h8" /></svg>{paper.award}</p>}
              {paper.summary && <details class="toggle"><summary>About this paper</summary><p>{paper.summary}</p></details>}
            </div>
          </li>
        ))}
      </ul>
      <details class="disclosure">
        <summary>Earlier publications</summary>
        <ul class="entries">
          {olderPublications.map(paper => (
            <li class="entry">
              <span class="entry-meta">{paper.year}</span>
              <div>
                <h3 class="entry-title"><a href={paper.href} target="_blank" rel="noopener">{paper.title}</a></h3>
                <p class="entry-text">{paper.authors} · {paper.venue}</p>
              </div>
            </li>
          ))}
        </ul>
      </details>
    </section>

    <section class="section" id="experience" aria-labelledby="experience-heading">
      <div class="section-head">
        <h2 id="experience-heading">Experience & education</h2>
        <a class="link" href="/cv.pdf">Full CV</a>
      </div>
      <ul class="entries">
        {roles.map(role => (
          <li class="entry">
            <span class="entry-meta">{role.date}</span>
            <div>
              <h3 class="entry-title">{role.title}</h3>
              <p class="entry-text">{role.organization}</p>
              <p class="entry-text">{role.description}</p>
            </div>
          </li>
        ))}
      </ul>
      <h3 class="section-subhead">Education</h3>
      <ul class="entries">
        {education.map(degree => (
          <li class="entry">
            <span class="entry-meta">{degree.date}</span>
            <div>
              <h3 class="entry-title">{degree.title}</h3>
              <p class="entry-text">{degree.organization}</p>
              {degree.description && <p class="entry-text">{degree.description}</p>}
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class="section" id="writing" aria-labelledby="writing-heading">
      <div class="section-head">
        <h2 id="writing-heading">Writing</h2>
        <a class="link" href="/blog">All writing</a>
      </div>
      <ul class="entries">
        {featuredPosts.map(post => (
          <li class="entry">
            <time class="entry-meta" datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time>
            <div>
              <h3 class="entry-title"><a class="stretched" href={`/blog/${post.slug}`}>{post.data.title}</a></h3>
              <p class="entry-text">{post.data.description}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class="section" aria-labelledby="life-teaser-heading">
      <div class="split">
        <div class="frame split-media">
          <Image src={bouldering} alt="Johannes bouldering in a mountain valley" widths={[600, 1000]} sizes="(max-width: 600px) 100vw, 444px" width={1000} format="webp" loading="lazy" />
        </div>
        <div class="split-body">
          <h2 id="life-teaser-heading">Life outside work</h2>
          <p>Climbing, making music, books, and dinner with friends.</p>
          <a class="button stretched" href="#life">Meet the other side of me</a>
        </div>
      </div>
    </section>
  </div>

  <div data-view="life" id="life">
    <section class="hero" aria-labelledby="life-title">
      <div class="hero-body">
        <h1 id="life-title" tabindex="-1">Still Johannes.</h1>
        <p class="hero-lede">A little less formal.</p>
        <p class="hero-text">Here's what life looks like away from the screen: climbing, making music, reading, and having friends over for dinner.</p>
        <div class="hero-actions">
          <a class="button button--primary" href="#life-about">A bit about me</a>
          <a class="button" href="#work">Back to work</a>
        </div>
      </div>
      <div class="frame hero-portrait">
        <Image src={casualPortrait} alt="Johannes smiling in a T-shirt and climbing harness" widths={[320, 640, 960]} sizes="(max-width: 600px) 22rem, 18rem" width={640} format="webp" loading="eager" />
      </div>
    </section>

    <section class="section" id="life-about" aria-labelledby="life-about-heading">
      <div class="section-head">
        <h2 id="life-about-heading">A bit about me</h2>
      </div>
      <div class="card-grid">
        {lifeStories.map(story => (
          <article class="card">
            <div class="frame card-media">
              <Image src={story.image} alt={story.alt} widths={[480, 900]} sizes="(max-width: 600px) 100vw, 444px" width={900} format="webp" loading="lazy" style={`object-position: ${story.position}`} />
            </div>
            <h3>{story.title}</h3>
            <p class="card-text">{story.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section" id="life-shelves" aria-labelledby="shelves-heading">
      <div class="section-head">
        <h2 id="shelves-heading">On my shelves</h2>
        <p class="section-lede">Books, music, and movies.</p>
      </div>
      <div class="shelf-grid">
        <div>
          <h3 class="shelf-title">Currently reading</h3>
          <ul class="book-list">
            {currentBooks.map((book, i) => (
              <li class="book">
                <Image class="book-cover" src={currentCovers[i]} alt={`${book.title} cover`} widths={[180, 280]} sizes="8.5rem" width={180} format="webp" loading="lazy" />
                <h4>{book.title}</h4>
                <p class="meta">{book.author}</p>
              </li>
            ))}
          </ul>
        </div>
        <div class="shelf-notes">
          <article>
            <h3>Music</h3>
            <p class="card-text">I listen to a bit of everything. Spotify probably knows my taste better than I do.</p>
            <div class="frame spotify-player">
              <iframe
                title="Johannes Roth Discover Weekly playlist"
                src="https://open.spotify.com/embed/playlist/37i9dQZEVXcKBQMbsgdSz3?utm_source=generator&theme=0"
                width="100%"
                height="152"
                allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                allowfullscreen
                loading="lazy"
              ></iframe>
            </div>
            <div class="link-row">
              <a class="link" href="https://open.spotify.com/playlist/37i9dQZEVXcKBQMbsgdSz3" target="_blank" rel="noopener">My Discover Weekly</a>
            </div>
          </article>
          <article>
            <h3>Horror movie night</h3>
            <p class="card-text">My wife and I watch horror movies with friends. I built a little recommender to help us choose.</p>
            <div class="link-row">
              <a class="link" href="https://horrorverse.jroth.space/app/movie-night" target="_blank" rel="noopener">Find our next movie</a>
              <a class="link" href="https://letterboxd.com/haukeman/" target="_blank" rel="noopener">My Letterboxd</a>
            </div>
          </article>
        </div>
      </div>
      <details class="disclosure book-archive">
        <summary>Books I've read</summary>
        <div class="book-archive-body">
          {lovedBookGroups.map(group => (
            <section class="book-group">
              <h3>{group.label}</h3>
              <ul class="book-grid">
                {group.books.map(([title, author, ref]) => (
                  <li class="archive-book">
                    {ref ? <img src={coverURL(ref)} alt={`${title} cover`} width="90" height="132" loading="lazy" decoding="async" /> : <div class="cover-placeholder" aria-hidden="true"></div>}
                    <div><p class="archive-title">{title}</p><p class="meta">{author}</p></div>
                  </li>
                ))}
              </ul>
            </section>
          ))}
          <section class="book-group">
            <h3>Found okay</h3>
            <ul class="book-grid">
              {okayBooks.map(([title, author, ref]) => (
                <li class="archive-book">
                  <img src={coverURL(ref)} alt={`${title} cover`} width="90" height="132" loading="lazy" decoding="async" />
                  <div><p class="archive-title">{title}</p><p class="meta">{author}</p></div>
                </li>
              ))}
            </ul>
          </section>
        </div>
      </details>
    </section>

    <section class="section" id="life-notes" aria-labelledby="life-notes-heading">
      <div class="section-head">
        <h2 id="life-notes-heading">Writing</h2>
        <a class="link" href="/blog">All writing</a>
        <p class="section-lede">Things I'm thinking about.</p>
      </div>
      <ul class="entries">
        {featuredPosts.map(post => (
          <li class="entry">
            <time class="entry-meta" datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time>
            <div>
              <h3 class="entry-title"><a class="stretched" href={`/blog/${post.slug}`}>{post.data.title}</a></h3>
              <p class="entry-text">{post.data.description}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <section class="section" id="contact" aria-labelledby="contact-heading">
    <div class="section-head">
      <h2 id="contact-heading">Say hi</h2>
      <p class="section-lede">For research, collaborations, or a good conversation.</p>
    </div>
    <a class="contact-email" href="mailto:johannes@roth24.de">johannes@roth24.de</a>
    <ul class="link-row contact-links">
      <li><a class="link" href="https://github.com/andropar" target="_blank" rel="noopener">GitHub</a></li>
      <li><a class="link" href="https://linkedin.com/in/johannes-roth-a67baa141" target="_blank" rel="noopener">LinkedIn</a></li>
      <li><a class="link" href="https://huggingface.co/andropar" target="_blank" rel="noopener">Hugging Face</a></li>
      <li><a class="link" href="https://scholar.google.com/citations?user=U3Z3J2gAAAAJ" target="_blank" rel="noopener">Google Scholar</a></li>
    </ul>
  </section>
</V2Layout>
