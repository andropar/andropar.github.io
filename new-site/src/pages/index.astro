  /* ── Professional / personal flip ── */
  .mode-shell {
    --personal-card-bg: rgba(255, 255, 255, 0.026);
    --personal-card-bg-hover: rgba(255, 255, 255, 0.044);
    --personal-card-border: var(--color-border-subtle);
    --personal-card-border-strong: var(--color-border);
    --personal-warm: #d69a3d;
    --personal-green: #7ea36b;
    --personal-rose: #c7725f;
  }

  .mode-shell[data-site-mode="professional"] .mode-content--personal,
  .mode-shell[data-site-mode="personal"] .mode-content--professional,
  .mode-shell[data-site-mode="professional"] .mode-section--personal,
  .mode-shell[data-site-mode="personal"] .mode-section--professional {
