    object-position: 52% 36%;
  }

  .personal-card--food .personal-card-media {
    object-position: 50% 50%;
  }

  .personal-card--bouldering .personal-card-media {
    object-position: center center;
  }

  .personal-card--meditation .personal-card-media {
    object-position: center center;
  }

