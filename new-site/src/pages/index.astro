    letter-spacing: 0;
    white-space: pre;
    transition: color var(--transition-base);
  }

  .intro-actions {
    display: flex;
    align-items: baseline;
    gap: 4px;
    min-height: 42px;
  }

  .mode-toggle-prompt {
    display: inline;
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.2;
  }

  .mode-toggle-prompt-text {
    white-space: nowrap;
  }

  .mode-toggle-prompt-text--professional {
    display: inline;
  }

  .mode-toggle-prompt-text--personal {
    display: none;
  }

  .mode-shell[data-site-mode="personal"] .mode-toggle-prompt-text--professional {
    display: none;
  }

  .mode-shell[data-site-mode="personal"] .mode-toggle-prompt-text--personal {
    display: inline;
  }

  .mode-toggle {
    position: relative;
    display: inline-grid;
    grid-template-areas: "label";
    align-items: center;
    justify-content: center;
    min-height: auto;
    padding: 0 1px;
    border: 0;
    border-radius: 0;
    color: transparent;
    background: transparent;
    font: inherit;
    line-height: 1.2;
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  .mode-toggle:hover {
    transform: translateY(-0.5px);
  }

  .mode-toggle::after {
    content: "";
    position: absolute;
    left: 1px;
    right: 1px;
    bottom: -3px;
    height: 1px;
    border-radius: 999px;
    background: linear-gradient(98deg, #8fbe91 0%, #d6a14a 48%, #cf7b6a 100%);
    opacity: 0.46;
    transform: scaleX(0.92);
    transform-origin: center;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .mode-toggle:hover::after {
    opacity: 0.86;
    transform: scaleX(1);
  }

  .mode-toggle:focus-visible {
    outline: 1px solid rgba(214, 161, 74, 0.52);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .mode-toggle-label {
    display: block !important;
    grid-area: label;
    white-space: nowrap;
    background: linear-gradient(98deg, #8fbe91 0%, #d6a14a 48%, #cf7b6a 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    transition: opacity 0.18s ease, visibility 0.18s ease;
  }

  .mode-toggle-label--professional {
    opacity: 1;
    visibility: visible;
  }

  .mode-toggle-label--personal {
    opacity: 0;
    visibility: hidden;
  }

  .mode-shell[data-site-mode="personal"] .mode-toggle-label--professional {
    opacity: 0;
    visibility: hidden;
  }

  .mode-shell[data-site-mode="personal"] .mode-toggle-label--personal {
    opacity: 1;
    visibility: visible;
  }

  .intro .intro-photo {
    isolation: isolate;
  }

  .intro .intro-photo::before {
    content: none !important;
    display: none !important;
  }

  .intro::after {
    content: none !important;
    display: none !important;
  }

  .intro .intro-photo .hero-portrait {
    position: absolute !important;
    left: 50% !important;
    right: auto !important;
    top: auto !important;
    bottom: 0 !important;
    width: auto !important;
    max-width: none !important;
    object-fit: contain !important;
    object-position: center bottom !important;
    pointer-events: none;
    transition:
      transform 0.72s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.72s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .intro .intro-photo .hero-portrait--professional {
    z-index: 1;
    height: min(calc(100% - 16px), calc(100vh - 200px)) !important;
    min-height: 470px;
    max-height: 660px;
    transform: translate(-50%, 8px) scale(1) !important;
    filter: grayscale(4%) contrast(1.02) !important;
  }

  .intro .intro-photo .hero-portrait--personal {
    z-index: 2;
    height: min(calc(100% - 16px), calc(100vh - 200px)) !important;
    min-height: 470px;
    max-height: 660px;
    transform: translate(-50%, 8px) scale(1) !important;
    filter: blur(7px) grayscale(22%) saturate(0.72) drop-shadow(0 34px 58px rgba(0, 0, 0, 0.24)) !important;
  }

  .mode-shell[data-site-mode="personal"] .intro .intro-photo .hero-portrait--professional {
    transform: translate(-50%, 8px) scale(1) !important;
    filter: blur(8px) grayscale(100%) drop-shadow(0 24px 42px rgba(0, 0, 0, 0.2)) !important;
  }

  .mode-shell[data-site-mode="personal"] .intro .intro-photo .hero-portrait--personal {
    transform: translate(-50%, 8px) scale(1) !important;
    filter: saturate(0.98) contrast(1.02) !important;
  }

  .intro-mobile-headshot-stack {
    display: none;
    position: relative;
  }

  .intro-mobile-headshot-stack .intro-mobile-headshot {
    transition:
      transform 0.58s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.58s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .intro-mobile-headshot-stack .hero-portrait--professional {
    transform: translate(0, 0) scale(1);
  }

  .intro-mobile-headshot-stack .hero-portrait--personal {
    transform: translate(0, 0) scale(1);
    filter: blur(5px) saturate(0.8);
  }

  .mode-shell[data-site-mode="personal"] .intro-mobile-headshot-stack .hero-portrait--professional {
    transform: translate(0, 0) scale(1);
    filter: blur(5px) grayscale(1);
  }

  .mode-shell[data-site-mode="personal"] .intro-mobile-headshot-stack .hero-portrait--personal {
    transform: translate(0, 0) scale(1);
    filter: saturate(0.96);
