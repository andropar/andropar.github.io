---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import V2Layout from '../layouts/V2Layout.astro';
import { currentBooks, lovedBookGroups, okayBooks } from '../data/books';
import { postLinkProps } from '../data/posts';
import { building, listening } from '../data/now';
import workPortrait from '../../public/v2/portrait-oxford-original-face.png';
import casualPortrait from '../../public/portrait-casual-hero.png';
import artAndFear from '../../public/v2/art-and-fear.jpg';
import mindIlluminated from '../../public/v2/the-mind-illuminated.jpg';
import bouldering from '../../public/personal/about-bouldering.webp';
import band from '../../public/personal/about-band.webp';
import food from '../../public/personal/about-good-food.webp';
import meditation from '../../public/personal/about-meditation.webp';

const posts = (await getCollection('blog')).filter(post => !post.data.draft).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featuredPosts = posts.slice(0, 2);
const latestPost = posts[0];
const dateLabel = (date: Date) => date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
const coverURL = (reference: string) => {
  const [kind, value] = reference.includes(':') ? reference.split(':') : ['isbn', reference];
  return `https://covers.openlibrary.org/b/${kind === 'id' ? 'id' : 'isbn'}/${value}-M.jpg`;
};
const currentCovers = [artAndFear, mindIlluminated];
const focusAreas = [
  { title: 'Machine learning & data science', description: 'Building models and using data to understand patterns, make predictions, and support decisions.' },
  { title: 'Production ML systems', description: 'Making ML systems reliable, efficient, and maintainable in everyday use.' },
  { title: 'Data engineering', description: 'Making data accessible, consistent, and useful for analysis and applications.' },
  { title: 'Backend & web development', description: 'Building useful applications and services with clear interfaces and maintainable architecture.' },
  { title: 'Research & experimental design', description: 'Turning open questions into testable ideas, sound experiments, and clear conclusions.' },
  { title: 'Project ownership & collaboration', description: 'Shaping the work, coordinating with others, and seeing projects through.' },
];
const skills = [
  'Python', 'PyTorch', 'scikit-learn', 'pandas', 'NumPy', 'Deep learning', 'Computer vision', 'Image segmentation',
  'Embeddings', 'Feature extraction', 'Recommender systems', 'Collaborative filtering', 'UMAP', 'Model evaluation',
  'Representational similarity analysis', 'fMRI analysis', 'Experimental design', 'Statistics', 'Dataset curation',
  'Data services', 'SQL', 'GPU pipelines', 'SLURM / HPC', 'Linux servers', 'AWS', 'Hugging Face', 'Git',
  'Research software', 'Django', 'JavaScript',
];
const publications = [
  { year: '2026', title: 'Characterizing Universal Object Representations Across Vision Models', authors: 'Mahner*, Roth* et al.', venue: 'NeurIPS 2026 (accepted)', graphic: 'universal', graphicAlt: 'Dimensions of object-similarity structure in ten vision models, one row per model, placed by how consistently each recurs in the others; one shared dimension is traced across all models', href: 'https://arxiv.org/abs/2605.13675', note: 'Shared first author', summary: 'We compared the object similarity structure of 162 vision models to distinguish universal from model-specific dimensions, and related that structure to image properties, neural activity, and human judgments.' },
  { year: '2025', title: 'How to sample the world for understanding the visual system', authors: 'Roth & Hebart', venue: 'CCN', graphic: 'sampling', graphicAlt: 'Clusters of natural photographs in a t-SNE map, with the clusters that THINGS and NSD barely cover highlighted', href: 'https://openreview.net/forum?id=T9k6KkZoca', note: 'Oral', summary: 'How does the choice of images affect what we can learn about the visual brain? We compared image-sampling strategies using simulations and fMRI data to study dataset coverage and model generalization.' },
  { year: '2025', title: 'Ten principles for reliable, efficient, and adaptable coding in psychology and cognitive neuroscience', authors: 'Roth*, Duan* et al.', venue: 'Communications Psychology', graphic: 'coding', graphicAlt: 'Every commit to the LAION-fMRI package in order, lines added above the axis and deleted below, with commits that touched the tests highlighted', href: 'https://doi.org/10.1038/s44271-025-00236-3', note: 'Shared first author', award: 'CMBB Replication Award', summary: 'A practical guide to research software, covering project organization, testing, documentation, version control, and collaboration.' },
];
const olderPublications = [
  { year: '2025', title: 'Fine-grained image and category information in ventral visual pathway', authors: 'Badwal, Bergmann, Roth et al.', venue: 'J Neuroscience', href: 'https://doi.org/10.1523/JNEUROSCI.0936-24.2024' },
  { year: '2023', title: 'High stimulus presentation rates for fMRI', authors: 'Roth, Miyawaki & Hebart', venue: 'VSS poster', href: 'https://jov.arvojournals.org/article.aspx?articleid=2791453' },
  { year: '2022', title: 'Multi-plane UNet++ Ensemble for Glioblastoma Segmentation', authors: 'Roth et al.', venue: 'MICCAI BrainLes 2021 proceedings', href: 'https://doi.org/10.1007/978-3-031-08999-2_23' },
  { year: '2021', title: 'Preferred stimuli for individual voxels in the human visual system', authors: 'Roth, Seeliger, Schmid & Hebart', venue: 'Cosyne poster', href: 'https://jov.arvojournals.org/article.aspx?articleid=2777378' },
];
const roles = [
  { span: [2022.33, null], date: 'May 2022–present', title: 'PhD Researcher · Computational Cognitive Neuroscience', organization: 'Max Planck Institute for Human Cognitive and Brain Sciences & University of Giessen', description: 'Independent research on vision models and human brain activity, with GPU-based data pipelines, fMRI experiments, and public research software.' },
  { span: [2021.42, 2022.33], date: 'Jun 2021–May 2022', title: 'Research Scientist · Machine Learning in Medicine', organization: 'ScaDS.AI Dresden/Leipzig', description: 'Deep-learning models for brain-tumor segmentation and predictive models for clinical data, including mortality prediction and uncertainty estimation.' },
  { span: [2019.83, 2021.33], date: 'Nov 2019–May 2021', title: 'Data Scientist / ML Engineer · Working student', organization: 'CHECK24, Travel Vertical', description: 'Designed and deployed a production computer-vision service for 20 million hotel images. Improved recommendation-data pipelines, reducing update time by over 95%.' },
  { span: [2020.75, 2021.33], date: 'Oct 2020–May 2021', title: 'Full-Stack Developer · Freelance', organization: 'Kimetric UG', description: 'Delivered Django websites for Hebart Lab and the THINGS Initiative, from client requirements to deployment, Linux hosting, and maintenance.' },
  { span: [2018.75, 2019.67], date: 'Oct 2018–Sep 2019', title: 'Data Scientist · Working student', organization: 'Webdata Solutions GmbH (now Vistex)', description: 'Developed machine-learning models for product matching and image classification in e-commerce.' },
  { span: [2018.08, 2018.58], date: 'Feb 2018–Aug 2018', title: 'Data Analyst · Working student', organization: 'Mercateo Services GmbH & Co. KG', description: 'Data integration, reporting, and testing for an AWS-based data warehouse using Apache NiFi and Pentaho.' },
];
const education = [
  { span: [2022.33, null], date: 'May 2022–present', title: 'Doctoral candidate · Dr. rer. nat.', organization: 'University of Giessen', description: 'Research focus: machine learning and computational neuroscience.' },
  { span: [2017.75, 2021.42], date: '2017–2021', title: 'M.Sc. Computer Science', organization: 'Leipzig University · Grade 1.2', description: 'Master’s thesis: generative deep learning for visual processing in the human brain (grade 1.1).' },
  { span: [2014.75, 2017.75], date: '2014–2017', title: 'B.Sc. Business Information Systems', organization: 'Leipzig University · Grade 1.5', description: '' },
];
// Role and degree spans share one scale, so the bars in the date column are comparable.
const now = new Date();
const timelineStart = 2014;
const timelineEnd = now.getFullYear() + now.getMonth() / 12;
const spanStyle = ([from, to]: (number | null)[]) => {
  const scale = (year: number) => ((year - timelineStart) / (timelineEnd - timelineStart)) * 100;
  return `--from: ${scale(from!).toFixed(1)}%; --to: ${scale(to ?? timelineEnd).toFixed(1)}%`;
};
const lifeStories = [
  { title: 'Movement', image: bouldering, position: '35% 50%', alt: 'Johannes bouldering on a rock face in a mountain valley', copy: 'My love for moving my body started with joining a breakdance crew at 17. These days I mostly boulder, lift weights, and do yoga. A day in the mountains with some climbing is hard to beat.' },
  { title: 'Music', image: band, position: '50% 30%', alt: 'Johannes holding an electric guitar', copy: 'A few years ago, I asked some friends if they wanted to start a band. Everyone said yes. We mostly play pop punk covers at birthday parties, but the dream of writing our own songs is still alive.' },
  { title: 'Food', image: food, position: '50% 50%', alt: 'A colorful plate of food on a wooden table', copy: 'I used to be an incredibly picky eater. Now I love throwing whole food ingredients together and having friends over for dinner. Hosting is a blast, even when it gets surprisingly stressful.' },
  { title: 'Meditation', image: meditation, position: '50% 50%', alt: 'A quiet forest path near the meditation hall', copy: 'Meditation and I have had an on-off relationship for over a decade. A ten-day silent retreat in 2024 changed a lot for me. I walked this forest path probably a hundred times and kept discovering something new.' },
];
---

<V2Layout title="Johannes Roth — Machine Learning & Research" wide>
  <div data-view="work" id="work">
    <section class="hero" aria-labelledby="work-title">
      <div class="hero-body">
        <h1 id="work-title" tabindex="-1">Johannes Roth</h1>
        <p class="hero-lede">Machine learning engineer & PhD researcher.</p>
        <p class="hero-text">I build computer-vision systems, data pipelines, and software for research. I study how vision models relate to human brain activity.</p>
        <div class="hero-actions">
          <a class="button button--primary" href="#selected-work">Explore my work</a>
          <a class="button" href="#contact">Get in touch</a>
        </div>
        <dl class="now">
          <div><dt>Building</dt><dd><a href={building.href} target="_blank" rel="noopener">{building.title}</a></dd></div>
          <div><dt>Writing</dt><dd><a {...postLinkProps(latestPost)}>{latestPost.data.title}</a></dd></div>
          <div><dt>Reading</dt><dd>{currentBooks[0].title}</dd></div>
        </dl>
        <p class="meta status">Available from January 2027</p>
      </div>
      <div class="frame hero-portrait">
        <Image src={workPortrait} alt="Johannes Roth smiling, in a light blue Oxford shirt with rolled sleeves and his arms crossed" widths={[320, 640, 960]} sizes="(max-width: 600px) 22rem, 25rem" width={640} format="webp" loading="eager" fetchpriority="high" />
      </div>
    </section>

    <section class="section section--band section--wide" id="selected-work" aria-labelledby="work-heading">
      <div class="section-head">
        <h2 id="work-heading">Selected work</h2>
        <a class="link" href="https://github.com/andropar" target="_blank" rel="noopener">More on GitHub</a>
      </div>
      <div class="project-group">
        <h3 class="section-subhead">Independent work</h3>
        <div class="card-grid card-grid--projects">
          <article class="card">
            <div class="frame card-media graphic graphic--horrorverse" data-hover="horrorverse" role="img" aria-label="The Horrorverse atlas: about 19,000 horror films as dots, with the haunted-house region highlighted"><span class="graphic-ink"></span><span class="graphic-accent"></span></div>
            <h3>Horrorverse</h3>
            <p class="card-text">Horror film recommendations, mood search, and a map of 20,000 films.</p>
            <p class="card-detail">A side project I built end to end: collaborative-filtering picks, text-embedding search, an explorable film atlas, accounts, and deployment.</p>
            <div class="card-footer">
              <a class="link stretched" href="https://horrorverse.jroth.space/" target="_blank" rel="noopener">Open Horrorverse</a>
            </div>
          </article>
          <article class="card">
            <div class="frame card-media graphic graphic--relaion" role="img" aria-label="A dithered contact sheet of natural photographs from the dataset"><span class="graphic-ink"></span><span class="graphic-accent"></span></div>
            <h3>ReLAION-natural</h3>
            <p class="card-text">Naturalistic images and embeddings for vision research.</p>
            <p class="card-detail">I developed pipelines for image classification, quality checks, and feature extraction to curate the dataset.</p>
            <div class="card-footer">
              <a class="link stretched" href="https://huggingface.co/datasets/andropar/relaion2b-natural" target="_blank" rel="noopener">View dataset</a>
            </div>
          </article>
        </div>
      </div>
      <div class="project-group">
        <h3 class="section-subhead">Collaborations</h3>
        <div class="card-grid card-grid--projects">
          <article class="card card--small">
            <div class="frame card-media graphic graphic--revision" data-hover="revision" role="img" aria-label="Brain-predictivity scores of 118 vision models, sorted, with the ten best highlighted"><span class="graphic-ink"></span><span class="graphic-accent"></span></div>
            <h3>re:vision</h3>
            <p class="card-text">Website, data services, and annotation tools for a replication initiative.</p>
            <div class="card-footer">
              <a class="link stretched" href="https://re-vision-initiative.org/" target="_blank" rel="noopener">Explore project</a>
            </div>
          </article>
          <article class="card card--small">
            <div class="frame card-media graphic graphic--laion" data-scrub="laion-sprite" data-frames="16" role="img" aria-label="A sagittal brain slice drawn as contour lines, with face- and scene-selective cortex filled in"><span class="graphic-ink"></span><span class="graphic-accent"></span></div>
            <h3>LAION-fMRI</h3>
            <p class="card-text">A public brain-imaging dataset for visual neuroscience.</p>
            <div class="card-footer">
              <a class="link stretched" href="https://laion-fmri.hebartlab.com/" target="_blank" rel="noopener">Explore project</a>
            </div>
          </article>
          <article class="card card--small">
            <div class="frame card-media graphic graphic--thingsvision" data-hover="thingsvision" role="img" aria-label="A similarity matrix of ResNet-50 features for eight image categories, one category highlighted"><span class="graphic-ink"></span><span class="graphic-accent"></span></div>
            <h3>thingsvision</h3>
            <p class="card-text">A common interface for extracting and comparing vision-model features.</p>
            <div class="card-footer">
              <a class="link stretched" href="https://github.com/ViCCo-Group/thingsvision" target="_blank" rel="noopener">View library</a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="section section--wide" id="research" aria-labelledby="research-heading">
      <div class="section-head">
        <h2 id="research-heading">Research & publications</h2>
        <a class="link" href="https://scholar.google.com/citations?user=U3Z3J2gAAAAJ" target="_blank" rel="noopener">Google Scholar</a>
        <p class="section-lede">At the Max Planck Institute and University of Giessen, I study how visual representations in models relate to the human brain.</p>
      </div>
      <div class="card-grid card-grid--papers breakout">
        {publications.filter(paper => paper.graphic).map(paper => (
          <article class="card">
            <div class="paper-media">
              <div class={`frame card-media graphic graphic--paper-${paper.graphic}`} role="img" aria-label={paper.graphicAlt}><span class="graphic-ink"></span><span class="graphic-accent"></span></div>
              {paper.award && <p class="award-note"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M7 3h10v6a5 5 0 0 1-10 0V3ZM7 5H4v2a4 4 0 0 0 4 4m9-6h3v2a4 4 0 0 1-4 4M12 14v6m-4 1h8" /></svg>{paper.award}</p>}
            </div>
            <p class="meta">{paper.year} · {paper.venue}</p>
            <h3 class="paper-title"><a href={paper.href} target="_blank" rel="noopener">{paper.title}</a></h3>
            <p class="card-detail">{paper.authors}{paper.note && <> · <span class="entry-note">{paper.note}</span></>}</p>
            {paper.summary && <details class="toggle"><summary>About this paper</summary><p>{paper.summary}</p></details>}
          </article>
        ))}
      </div>
      <details class="disclosure">
        <summary>Earlier publications</summary>
        <ul class="entries">
          {olderPublications.map(paper => (
            <li class="entry">
              <span class="entry-meta">{paper.year}</span>
              <div>
                <h3 class="entry-title"><a href={paper.href} target="_blank" rel="noopener">{paper.title}</a></h3>
                <p class="entry-text">{paper.authors} · {paper.venue}</p>
              </div>
            </li>
          ))}
        </ul>
      </details>
    </section>

    <section class="section section--wide" id="experience" aria-labelledby="experience-heading">
      <div class="section-head">
        <h2 id="experience-heading">Experience & education</h2>
        <a class="link" href="/cv.pdf">Full CV</a>
      </div>
      <div class="cv-columns breakout" style={`--row-end: ${Math.max(roles.length, education.length) + 2}`}>
        <div>
          <h3 class="section-subhead">Experience</h3>
          <ul class="entries">
            {roles.map(role => (
              <li class="entry">
                <span class="entry-meta">{role.date}<span class:list={['span-bar', { 'span-bar--current': !role.span[1] }]} style={spanStyle(role.span)} aria-hidden="true"></span></span>
                <div>
                  <h3 class="entry-title">{role.title}</h3>
                  <p class="entry-text">{role.organization}</p>
                  <p class="entry-text">{role.description}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="section-subhead">Education</h3>
          <ul class="entries">
            {education.map(degree => (
              <li class="entry">
                <span class="entry-meta">{degree.date}<span class:list={['span-bar', { 'span-bar--current': !degree.span[1] }]} style={spanStyle(degree.span)} aria-hidden="true"></span></span>
                <div>
                  <h3 class="entry-title">{degree.title}</h3>
                  <p class="entry-text">{degree.organization}</p>
                  {degree.description && <p class="entry-text">{degree.description}</p>}
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="section" id="capabilities" aria-labelledby="capabilities-heading">
      <div class="section-head">
        <h2 id="capabilities-heading">Expertise</h2>
      </div>
      <dl class="focus-grid">
        {focusAreas.map(area => <div><dt>{area.title}</dt><dd>{area.description}</dd></div>)}
      </dl>
      <div class="skill-line">
        <h3>Methods & tools</h3>
        <ul class="pills">{skills.map(skill => <li>{skill}</li>)}</ul>
      </div>
    </section>

    <section class="section" id="writing" aria-labelledby="writing-heading">
      <div class="section-head">
        <h2 id="writing-heading">Writing</h2>
        <a class="link" href="/blog">All writing</a>
      </div>
      <ul class="entries">
        {featuredPosts.map(post => (
          <li class="entry">
            <time class="entry-meta" datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time>
            <div>
              <h3 class="entry-title"><a class="stretched" {...postLinkProps(post)}>{post.data.title}</a></h3>
              <p class="entry-text">{post.data.description}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class="section" aria-labelledby="life-teaser-heading">
      <div class="split">
        <div class="frame split-media">
          <Image class="photo-grade" src={bouldering} alt="Johannes bouldering in a mountain valley" widths={[600, 1000]} sizes="(max-width: 600px) 100vw, 444px" width={1000} format="webp" loading="lazy" />
        </div>
        <div class="split-body">
          <h2 id="life-teaser-heading">Life outside work</h2>
          <p>Climbing, making music, books, and dinner with friends.</p>
          <a class="button stretched" href="#life">Meet the other side of me</a>
        </div>
      </div>
    </section>
  </div>

  <div data-view="life" id="life">
    <section class="hero" aria-labelledby="life-title">
      <div class="hero-body">
        <h1 id="life-title" tabindex="-1">Still Johannes.</h1>
        <p class="hero-lede">A little less formal.</p>
        <p class="hero-text">Here's what life looks like away from the screen: climbing, making music, reading, and having friends over for dinner.</p>
        <div class="hero-actions">
          <a class="button button--primary" href="#life-about">A bit about me</a>
          <a class="button" href="#work">Back to work</a>
        </div>
        <dl class="now">
          <div><dt>Reading</dt><dd>{currentBooks.map(book => book.title).join(', ')}</dd></div>
          <div><dt>Writing</dt><dd><a {...postLinkProps(latestPost)}>{latestPost.data.title}</a></dd></div>
          <div><dt>Listening</dt><dd><a href={listening.href} target="_blank" rel="noopener">{listening.title}</a></dd></div>
        </dl>
      </div>
      <div class="frame hero-portrait">
        <Image src={casualPortrait} alt="Johannes smiling in a T-shirt and climbing harness" widths={[320, 640, 960]} sizes="(max-width: 600px) 22rem, 25rem" width={640} format="webp" loading="eager" />
      </div>
    </section>

    <section class="section section--wide" id="life-about" aria-labelledby="life-about-heading">
      <div class="section-head">
        <h2 id="life-about-heading">A bit about me</h2>
      </div>
      <div class="life-stories breakout">
        {lifeStories.map(story => (
          <article class="story">
            <div class="frame story-media">
              <Image class="photo-grade" src={story.image} alt={story.alt} widths={[600, 1000]} sizes="(max-width: 600px) 100vw, 680px" width={1000} format="webp" loading="lazy" style={`object-position: ${story.position}`} />
            </div>
            <div class="story-body">
              <h3>{story.title}</h3>
              <p>{story.copy}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section section--band section--wide" id="life-shelves" aria-labelledby="shelves-heading">
      <div class="section-head">
        <h2 id="shelves-heading">On my shelves</h2>
        <p class="section-lede">Books, music, and movies.</p>
      </div>
      <div class="shelf-grid">
        <article class="shelf-note">
          <h3>Music</h3>
          <p class="card-text">I listen to a bit of everything. Spotify probably knows my taste better than I do.</p>
          <div class="frame shelf-media">
            <iframe
              title="Johannes Roth Discover Weekly playlist"
              src="https://open.spotify.com/embed/playlist/37i9dQZEVXcKBQMbsgdSz3?utm_source=generator&theme=0"
              width="100%"
              height="152"
              allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
          <div class="link-row">
            <a class="link" href="https://open.spotify.com/playlist/37i9dQZEVXcKBQMbsgdSz3" target="_blank" rel="noopener">My Discover Weekly</a>
          </div>
        </article>
        <article class="shelf-note">
          <h3>Horror movie night</h3>
          <p class="card-text">My wife and I watch horror movies with friends. I built a little recommender to help us choose.</p>
          <div class="frame shelf-media graphic graphic--horrorverse" data-hover="horrorverse" role="img" aria-label="The Horrorverse atlas of horror films, with the haunted-house region highlighted"><span class="graphic-ink"></span><span class="graphic-accent"></span></div>
          <div class="link-row">
            <a class="link" href="https://horrorverse.jroth.space/app/movie-night" target="_blank" rel="noopener">Find our next movie</a>
            <a class="link" href="https://letterboxd.com/haukeman/" target="_blank" rel="noopener">My Letterboxd</a>
          </div>
        </article>
      </div>

      <h3 class="shelf-title">Books</h3>
      <div class="cover-wall">
        <div class="cover-row">
          <h4>Reading now</h4>
          <ul class="covers">
            {currentBooks.map((book, i) => (
              <li class="cover cover--current" title={`${book.title} · ${book.author}`}>
                <Image src={currentCovers[i]} alt={`${book.title} by ${book.author}`} widths={[96, 144]} sizes="3rem" width={144} format="webp" loading="lazy" />
              </li>
            ))}
          </ul>
        </div>
        <div class="cover-row">
          <h4>Loved</h4>
          <ul class="covers covers--dense">
            {lovedBookGroups.flatMap(group => group.books.map(([title, author, ref]) => (
              <li class="cover" title={`${title} · ${author} · ${group.label}`}>
                {ref ? <img src={coverURL(ref)} alt={`${title} by ${author}`} width="80" height="120" loading="lazy" decoding="async" /> : <span class="cover-placeholder">{title}</span>}
              </li>
            )))}
          </ul>
        </div>
      </div>
      <details class="disclosure book-archive">
        <summary>Books I found okay</summary>
        <div class="book-archive-body">
          <ul class="book-grid">
            {okayBooks.map(([title, author, ref]) => (
              <li class="archive-book">
                <img src={coverURL(ref)} alt={`${title} cover`} width="90" height="132" loading="lazy" decoding="async" />
                <div><p class="archive-title">{title}</p><p class="meta">{author}</p></div>
              </li>
            ))}
          </ul>
        </div>
      </details>
    </section>

    <section class="section" id="life-notes" aria-labelledby="life-notes-heading">
      <div class="section-head">
        <h2 id="life-notes-heading">Writing</h2>
        <a class="link" href="/blog">All writing</a>
        <p class="section-lede">Things I'm thinking about.</p>
      </div>
      <ul class="entries">
        {featuredPosts.map(post => (
          <li class="entry">
            <time class="entry-meta" datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time>
            <div>
              <h3 class="entry-title"><a class="stretched" {...postLinkProps(post)}>{post.data.title}</a></h3>
              <p class="entry-text">{post.data.description}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <section class="section section--band section--closing" id="contact" aria-labelledby="contact-heading">
    <div class="section-head">
      <h2 id="contact-heading">Say hi</h2>
      <p class="section-lede">For research, collaborations, or a good conversation.</p>
    </div>
    <a class="contact-email" href="mailto:johannes@roth24.de">johannes@roth24.de</a>
    <p class="meta status">Available from January 2027</p>
    <ul class="link-row contact-links">
      <li><a class="link" href="https://github.com/andropar" target="_blank" rel="noopener">GitHub</a></li>
      <li><a class="link" href="https://linkedin.com/in/johannes-roth-a67baa141" target="_blank" rel="noopener">LinkedIn</a></li>
      <li><a class="link" href="https://huggingface.co/andropar" target="_blank" rel="noopener">Hugging Face</a></li>
      <li><a class="link" href="https://scholar.google.com/citations?user=U3Z3J2gAAAAJ" target="_blank" rel="noopener">Google Scholar</a></li>
    </ul>
  </section>
</V2Layout>

