  }

  .personal-card--with-media {
    min-height: 0;
    padding: 0;
    overflow: hidden;
  }

  .personal-card-media {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    object-fit: cover;
    object-position: center;
    filter: saturate(0.92) contrast(0.98);
    transition: filter 0.2s ease, transform 0.2s ease;
  }

  .personal-card-body {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: 18px;
  }

  .personal-card:hover .personal-card-media {
