      padding-inline: clamp(28px, 3.3vw, 42px);
    }

    .mode-section::before {
      inset-inline: 0 !important;
    }

    .intro {
      grid-template-columns: minmax(0, 0.56fr) minmax(320px, 0.44fr);
      align-items: stretch;
    }

    .intro-copy {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      min-height: 100%;
      padding-top: clamp(18px, 2.4vw, 34px);
      padding-bottom: clamp(50px, 8vh, 92px);
    }

    .intro .intro-title {
      line-height: 0.94 !important;
    }

    .intro .intro-name-row,
    .intro .intro-bio-stack,
    .intro .intro-actions {
      width: 100%;
      max-width: 620px;
    }

    .intro .intro-actions {
      margin-top: auto !important;
      padding-top: clamp(28px, 5vh, 56px);
    }

    .intro .intro-photo {
      grid-column: 2;
      grid-row: 1;
      align-self: stretch;
    }
  }

  .intro-bio-stack {
    display: grid;
  }

  .intro-bio-group {
    grid-area: 1 / 1;
    transition: opacity 0.24s ease, visibility 0.24s ease;
  }

  .intro-bio-group--professional {
    opacity: 1;
    visibility: visible;
  }

  .intro-bio-group--personal {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .mode-shell[data-site-mode="personal"] .intro-bio-group--professional {
    display: none;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .mode-shell[data-site-mode="personal"] .intro-bio-group--personal {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .mode-shell[data-site-mode="professional"] .intro-bio-group--personal {
    display: none;
  }

  .personal-ascii-hero {
    --personal-cat-color: rgba(214, 154, 61, 0.58);
    position: absolute;
    left: 0;
    bottom: clamp(150px, 12vh, 180px);
    z-index: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: min(100%, 620px);
    height: clamp(94px, 14vh, 138px);
    min-height: 0;
    margin-top: 0;
    padding: 0;
    overflow: hidden;
    pointer-events: none;
    background: transparent;
  }

  :global([data-theme="light"]) .personal-ascii-hero {
    --personal-cat-color: rgba(43, 69, 45, 0.5);
  }

  :global([data-theme="dark"]) .personal-ascii-hero {
    --personal-cat-color: rgba(214, 154, 61, 0.58);
  }

  .personal-ascii-hero pre {
    margin: 0;
    color: var(--personal-cat-color);
    font-family: var(--font-mono);
    font-size: clamp(29px, 3.2vw, 42px);
