      min-height: 0;
    }

    .personal-grid--life .personal-card-media {
      height: 100%;
      min-height: 300px;
      aspect-ratio: auto;
      border-right: 1px solid var(--personal-card-border);
      border-bottom: 0;
    }

    .personal-card--bouldering .personal-card-media {
      object-position: 34% center;
    }

    .personal-card--band .personal-card-media {
      object-position: 52% 34%;
    }

    .personal-card--food .personal-card-media {
      object-position: 50% 50%;
    }

    .personal-card--meditation {
      grid-template-columns: minmax(0, 1fr) minmax(250px, 0.62fr) !important;
