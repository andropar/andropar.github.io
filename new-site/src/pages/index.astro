type LetterboxdFilm = {
  title: string;
  year: string;
  href: string;
  poster: string;
  rating: number;
  ratingStars: string;
  ratedDate: string;
  ratedLabel: string;
};

const letterboxdBaseUrl = 'https://letterboxd.com';
const letterboxdRssUrl = 'https://letterboxd.com/haukeman/rss/';
const letterboxdProfileUrl = 'https://letterboxd.com/haukeman/';
const letterboxdFilmsUrl = 'https://letterboxd.com/haukeman/films/';
const letterboxdRequestHeaders = {
  'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8',
  'User-Agent': 'Mozilla/5.0 (compatible; johannesroth.dev build)',
};

const fallbackLetterboxdFilms: LetterboxdFilm[] = [
  {
    title: 'Christine',
    year: '1983',
    href: 'https://letterboxd.com/film/christine-1983/',
    poster: 'https://a.ltrbxd.com/resized/film-poster/4/7/6/1/5/47615-christine-0-230-0-345-crop.jpg?v=368af14bb5',
    rating: 3.5,
    ratingStars: '★★★½',
    ratedDate: '2026-06-07',
    ratedLabel: 'Rated Jun 7, 2026',
  },
  {
    title: 'Hokum',
    year: '2026',
    href: 'https://letterboxd.com/film/hokum/',
    poster: 'https://a.ltrbxd.com/resized/film-poster/1/3/0/8/5/8/7/1308587-hokum-0-230-0-345-crop.jpg?v=29deb57767',
    rating: 2.5,
    ratingStars: '★★½',
    ratedDate: '2026-06-07',
    ratedLabel: 'Rated Jun 7, 2026',
  },
  {
    title: 'Zodiac',
    year: '2007',
    href: 'https://letterboxd.com/film/zodiac/',
    poster: 'https://a.ltrbxd.com/resized/sm/upload/58/tf/z6/gw/qKQIjErYaN149hZRP5Vgf8RoC7S-0-230-0-345-crop.jpg?v=72ee5db942',
    rating: 4.5,
    ratingStars: '★★★★½',
    ratedDate: '2026-06-07',
    ratedLabel: 'Rated Jun 7, 2026',
  },
];

const decodeHtml = (value: string) => value
  .replace(/<!\[CDATA\[|\]\]>/g, '')
  .replace(/&(#x[\da-f]+|#\d+|amp|apos|quot|lt|gt|#039);/gi, (match, entity) => {
    const normalized = entity.toLowerCase();
    if (normalized.startsWith('#x')) {
      return String.fromCharCode(Number.parseInt(normalized.slice(2), 16));
    }
    if (normalized.startsWith('#')) {
      return String.fromCharCode(Number.parseInt(normalized.slice(1), 10));
    }
    const namedEntities: Record<string, string> = {
      amp: '&',
      apos: "'",
      quot: '"',
      lt: '<',
      gt: '>',
      '#039': "'",
    };
    return namedEntities[normalized] ?? match;
  });

const extractRssTag = (item: string, tag: string) => {
  const escapedTag = tag.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  const match = item.match(new RegExp(`<${escapedTag}>([\\s\\S]*?)</${escapedTag}>`));
  return match ? decodeHtml(match[1].trim()) : '';
};

const formatLetterboxdRating = (rating: number) => {
  const fullStars = Math.floor(rating);
  const hasHalfStar = rating % 1 >= 0.5;
  return `${'★'.repeat(fullStars)}${hasHalfStar ? '½' : ''}`;
};

const formatLetterboxdDate = (dateString: string) => {
  if (!dateString) return '';
  const normalizedDate = dateString.replace(/^on\s+/i, '').trim();
  const date = new Date(
    /^\d{4}-\d{2}-\d{2}$/.test(normalizedDate)
      ? `${normalizedDate}T12:00:00Z`
      : normalizedDate,
  );
  if (Number.isNaN(date.valueOf())) return 'Recently';
  return date.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
};

const extractPosterFromDescription = (description: string) => {
  const match = description.match(/<img[^>]+src="([^"]+)"/);
  return match ? decodeHtml(match[1]) : '';
};

const absoluteLetterboxdUrl = (path: string) => new URL(decodeHtml(path), letterboxdBaseUrl).toString();

const fetchLetterboxdText = async (url: string, timeoutMs = 6000) => {
  const controller = new AbortController();
  const timeoutId = setTimeout(() => controller.abort(), timeoutMs);

  try {
    const response = await fetch(url, {
      headers: letterboxdRequestHeaders,
      signal: controller.signal,
    });

    if (!response.ok) {
      throw new Error(`${url} returned ${response.status}`);
    }

    return await response.text();
  } finally {
    clearTimeout(timeoutId);
  }
};

const parseLetterboxdActivity = (html: string): LetterboxdFilm[] => {
  const ratedActivityPattern = /<span class="activity-summary">[\s\S]*?\srated\s+<a href="([^"]+)" class="target">([\s\S]*?)<\/a>\s*<span class="rating[^"]*rated-(\d+)[^"]*">\s*([^<]+?)\s*<\/span>[\s\S]*?<time datetime="([^"]+)"[^>]*>([\s\S]*?)<\/time>/g;

  return Array.from(html.matchAll(ratedActivityPattern))
    .map(([, href, title, ratingValue, ratingStars, ratedDate, visibleDate]) => {
      const rating = Number.parseInt(ratingValue, 10) / 2;
      const formattedDate = formatLetterboxdDate(decodeHtml(visibleDate));

      if (!Number.isFinite(rating) || !title || !href) return null;

      return {
        title: decodeHtml(title),
        year: '',
        href: absoluteLetterboxdUrl(href),
        poster: '',
        rating,
        ratingStars: decodeHtml(ratingStars.trim()) || formatLetterboxdRating(rating),
        ratedDate,
        ratedLabel: formattedDate ? `Rated ${formattedDate}` : '',
      };
    })
    .filter((film): film is LetterboxdFilm => Boolean(film))
    .slice(0, 3);
};

const parseLetterboxdFilmsGrid = (html: string): LetterboxdFilm[] => {
  const filmGridPattern = /data-component-class="LazyPoster"[^>]*data-item-name="([^"]+)"[^>]*data-item-link="([^"]+)"[^>]*data-poster-url="([^"]+)"[\s\S]*?<p class="poster-viewingdata"[\s\S]*?<span class="rating[^"]*rated-(\d+)[^"]*">\s*([^<]+?)\s*<\/span>/g;

  return Array.from(html.matchAll(filmGridPattern))
    .map(([, itemName, href, posterPath, ratingValue, ratingStars]) => {
      const decodedName = decodeHtml(itemName);
      const titleMatch = decodedName.match(/^(.*)\s+\((\d{4})\)$/);
      const rating = Number.parseInt(ratingValue, 10) / 2;

      if (!Number.isFinite(rating) || !href) return null;

      return {
        title: titleMatch?.[1] ?? decodedName,
        year: titleMatch?.[2] ?? '',
        href: absoluteLetterboxdUrl(href),
        poster: posterPath ? absoluteLetterboxdUrl(posterPath) : '',
        rating,
        ratingStars: decodeHtml(ratingStars.trim()) || formatLetterboxdRating(rating),
        ratedDate: '',
        ratedLabel: '',
      };
    })
    .filter((film): film is LetterboxdFilm => Boolean(film))
    .slice(0, 3);
};

const enrichLetterboxdFilm = async (film: LetterboxdFilm): Promise<LetterboxdFilm> => {
  if (film.poster.startsWith('https://a.ltrbxd.com') && film.year) return film;

  try {
    const html = await fetchLetterboxdText(film.href, 5000);
    const poster = html.match(/"image":"([^"]+)"/)?.[1] ?? film.poster;
    const year = html.match(/"releasedEvent":\[\{"@type":"PublicationEvent","startDate":"(\d{4})/)?.[1] ?? film.year;

    return {
      ...film,
      year,
      poster: decodeHtml(poster),
    };
  } catch {
    return film;
  }
};

const enrichLetterboxdFilms = async (films: LetterboxdFilm[]) => Promise.all(
  films.map((film) => enrichLetterboxdFilm(film)),
);

const parseLetterboxdFeed = (rss: string): LetterboxdFilm[] => {
  return Array.from(rss.matchAll(/<item>\s*([\s\S]*?)\s*<\/item>/g))
    .map(([, item]) => {
      const rating = Number.parseFloat(extractRssTag(item, 'letterboxd:memberRating'));
      const title = extractRssTag(item, 'letterboxd:filmTitle');
      const year = extractRssTag(item, 'letterboxd:filmYear');
      const href = extractRssTag(item, 'link');
      const watchedDate = extractRssTag(item, 'letterboxd:watchedDate');
      const formattedDate = formatLetterboxdDate(watchedDate);
      const description = extractRssTag(item, 'description');
      const poster = extractPosterFromDescription(description);

      if (!Number.isFinite(rating) || !title || !href) return null;

      return {
        title,
        year,
        href,
        poster,
        rating,
        ratingStars: formatLetterboxdRating(rating),
        ratedDate: watchedDate,
        ratedLabel: formattedDate ? `Rated ${formattedDate}` : '',
      };
    })
    .filter((film): film is LetterboxdFilm => Boolean(film))
    .slice(0, 3);
};

const getRecentLetterboxdFilms = async () => {
  try {
    const films = parseLetterboxdActivity(await fetchLetterboxdText(letterboxdProfileUrl));
    if (films.length >= 3) return await enrichLetterboxdFilms(films);
  } catch (error) {
    console.warn('Letterboxd profile activity unavailable:', error);
  }

  try {
    const films = parseLetterboxdFilmsGrid(await fetchLetterboxdText(letterboxdFilmsUrl));
    if (films.length >= 3) return await enrichLetterboxdFilms(films);
  } catch (error) {
    console.warn('Letterboxd films grid unavailable:', error);
  }

  try {
    const films = parseLetterboxdFeed(await fetchLetterboxdText(letterboxdRssUrl));
    if (films.length >= 3) return films;
  } catch (error) {
    console.warn('Letterboxd RSS unavailable:', error);
  }

  return fallbackLetterboxdFilms;
};

const recentLetterboxdFilms = await getRecentLetterboxdFilms();

const openLibraryCover = (coverRef: string) => {
  const [kind, value] = coverRef.includes(':') ? coverRef.split(':') : ['isbn', coverRef];
  const endpoint = kind === 'id' ? 'id' : 'isbn';
  return `https://covers.openlibrary.org/b/${endpoint}/${value}-M.jpg`;
};
const formatPostDate = (date: Date) => date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
