---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Johannes Roth">
  <section class="intro">
      <p class="intro-greeting"><span class="coordinates">51.3397° N, 12.3731° E</span></p>
      <div class="intro-name-row">
        <div class="intro-photo">
          <img src="/prof_pic.jpg" alt="Johannes Roth" />
        </div>
        <h1 class="intro-title">Johannes Roth</h1>
      </div>
      <p class="intro-bio">
        I study how the brain makes sense of what we see - and how we can use AI to understand it better.
        Currently finishing my <strong>PhD in Computational Cognitive Neuroscience</strong> at the
        Max Planck Institute in Leipzig.
      </p>
      <p class="intro-bio">
        Before academia, I worked as a data scientist building recommendation systems and ML pipelines.
        I like problems that sit at the intersection of <strong>neuroscience, machine learning, and
        building things that work</strong>.
      </p>

      <div class="status">
        <span class="status-dot"></span>
        Open to opportunities starting September 2026
      </div>

      <div class="quick-links">
        <a href="/about" class="quick-link">My story</a>
        <a href="/projects" class="quick-link">Projects</a>
        <a href="mailto:johannes@roth24.de" class="quick-link">Get in touch</a>
      </div>

    </section>

    <section class="section">
      <h2 class="section-title">Selected Work</h2>
      <div class="selected-work">
        <a href="/projects" class="work-item">
          <span class="work-venue">CCN 2025 · Oral</span>
          <h3>How to sample the world for understanding the visual system</h3>
          <p>A framework for choosing which images to show in neuroimaging experiments — so we can learn more from fewer trials.</p>
        </a>
        <a href="https://huggingface.co/datasets/andropar/relaion2b-natural" class="work-item" target="_blank">
          <span class="work-venue">Dataset</span>
          <h3>ReLAION-2B Natural</h3>
          <p>Scored 2.1 billion images for naturalness and extracted embeddings for the ~500M most photographic ones. 167GB on Hugging Face.</p>
        </a>
        <a href="https://doi.org/10.1038/s44271-025-00236-3" class="work-item" target="_blank">
          <span class="work-venue">Comms Psychology 2025</span>
          <h3>Ten principles for reliable, efficient, and adaptable coding</h3>
          <p>A practical guide for scientists who code — covering everything from version control to testing to writing reusable pipelines.</p>
        </a>
      </div>
    </section>
</Layout>

<style>
  /* Intro Section */
  .intro {
    margin-bottom: var(--space-4xl);
  }

  .intro-name-row {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .intro-photo {
    width: 56px;
    height: 56px;
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-bg-subtle);
    flex-shrink: 0;
  }

  .intro-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .intro-name-row .intro-title {
    margin: 0;
  }

  /* Selected Work */
  .selected-work {
    display: flex;
    flex-direction: column;
  }

  .work-item {
    display: block;
    padding: var(--space-lg) 0;
    border-bottom: 1px solid var(--color-border-subtle);
    text-decoration: none;
    transition: opacity 0.2s ease;
    position: relative;
  }

  .work-item:first-child {
    padding-top: 0;
  }

  .work-item:last-child {
    border-bottom: none;
  }

  .work-item:hover {
    opacity: 0.7;
  }

  .work-venue {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
  }

  .work-item h3 {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    color: var(--color-text);
    margin: var(--space-xs) 0;
  }

  .work-item p {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    margin: 0;
  }

</style>
