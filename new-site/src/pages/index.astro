  .personal-card,
  .personal-shelf,
  .personal-note {
    min-height: 214px;
    padding: 18px;
    border: 1px solid var(--personal-card-border);
    border-radius: 8px;
    background: var(--personal-card-bg);
    transition: border-color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
  }

  .personal-note {
