</style>

<script>
  // Tiny metaphorical animations for each tool type
  document.querySelectorAll('.tool-anim').forEach((canvas) => {
    const ctx = canvas.getContext('2d');
    const type = canvas.dataset.anim;
    const dpr = window.devicePixelRatio || 1;
    const w = canvas.width;
    const h = canvas.height;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    canvas.style.width = w + 'px';
    canvas.style.height = h + 'px';
    ctx.scale(dpr, dpr);

    function getColor(alpha) {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      return isDark ? `rgba(170,170,170,${alpha})` : `rgba(80,80,80,${alpha})`;
    }

    // Sift: particles falling, some drift left (rejected), some land right (kept)
    if (type === 'sift') {
      const particles = [];
      for (let i = 0; i < 14; i++) {
        particles.push({
          x: 8 + Math.random() * 32,
          y: Math.random() * h,
          speed: 0.15 + Math.random() * 0.25,
          keep: Math.random() < 0.3,
          phase: Math.random() * Math.PI * 2,
          size: 1 + Math.random() * 1.2,
        });
      }
      function draw() {
        ctx.clearRect(0, 0, w, h);
        for (const p of particles) {
          p.y += p.speed;
          if (p.y > h * 0.5 && !p.keep) p.x -= 0.12;
          if (p.y > h + 4) { p.y = -2; p.x = 8 + Math.random() * 32; }
          const alpha = p.keep ? 0.7 : Math.max(0, 0.5 - (p.y / h) * 0.5);
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
          ctx.fillStyle = getColor(alpha);
          ctx.fill();
        }
        requestAnimationFrame(draw);
      }
      draw();
    }

    // Hub: center dot with orbiting satellites connected by lines
    if (type === 'hub') {
      const satellites = [];
      for (let i = 0; i < 6; i++) {
        const angle = (i / 6) * Math.PI * 2;
        satellites.push({
          angle,
          dist: 8 + Math.random() * 5,
          speed: 0.2 + Math.random() * 0.3,
          size: 1 + Math.random() * 0.8,
        });
      }
      function draw() {
        const t = performance.now() * 0.001;
        ctx.clearRect(0, 0, w, h);
        const cx = w / 2, cy = h / 2;

        for (const s of satellites) {
          const a = s.angle + t * s.speed;
          const sx = cx + Math.cos(a) * s.dist;
          const sy = cy + Math.sin(a) * s.dist;
          ctx.beginPath();
          ctx.moveTo(cx, cy);
          ctx.lineTo(sx, sy);
          ctx.strokeStyle = getColor(0.25);
          ctx.lineWidth = 0.5;
          ctx.stroke();
          ctx.beginPath();
          ctx.arc(sx, sy, s.size, 0, Math.PI * 2);
          ctx.fillStyle = getColor(0.6);
          ctx.fill();
        }
        ctx.beginPath();
        ctx.arc(cx, cy, 2, 0, Math.PI * 2);
        ctx.fillStyle = getColor(0.8);
        ctx.fill();

        requestAnimationFrame(draw);
      }
      draw();
    }

    // Matrix: small grid of cells that light up in cross-validated patterns
    if (type === 'matrix') {
      const cols = 6, rows = 4;
      const cellW = (w - 8) / cols, cellH = (h - 4) / rows;
      function draw() {
        const t = performance.now() * 0.001;
        ctx.clearRect(0, 0, w, h);
        for (let r = 0; r < rows; r++) {
          for (let c = 0; c < cols; c++) {
            const val = Math.sin(t * 1.2 + c * 0.9 + r * 1.3) * 0.5 + 0.5;
            const x = 4 + c * cellW, y = 2 + r * cellH;
            ctx.fillStyle = getColor(0.08 + val * 0.45);
            ctx.fillRect(x + 0.5, y + 0.5, cellW - 1, cellH - 1);
          }
        }
        requestAnimationFrame(draw);
      }
      draw();
    }

    // Scan: dots in a grid with a spotlight sweeping across
    if (type === 'scan') {
      const dots = [];
      for (let r = 0; r < 4; r++) {
        for (let c = 0; c < 6; c++) {
          dots.push({ x: 6 + c * 7, y: 4 + r * 7, base: 0.15 });
        }
      }
      function draw() {
        const t = performance.now() * 0.001;
        ctx.clearRect(0, 0, w, h);
        const spotX = (Math.sin(t * 0.8) * 0.5 + 0.5) * w;
        const spotY = (Math.cos(t * 0.5) * 0.5 + 0.5) * h;
        for (const d of dots) {
          const dx = d.x - spotX, dy = d.y - spotY;
          const dist = Math.sqrt(dx * dx + dy * dy);
          const boost = Math.max(0, 1 - dist / 16);
          const alpha = d.base + boost * 0.65;
          const size = 1.2 + boost * 1.2;
          ctx.beginPath();
          ctx.arc(d.x, d.y, size, 0, Math.PI * 2);
          ctx.fillStyle = getColor(alpha);
          ctx.fill();
        }
        requestAnimationFrame(draw);
      }
      draw();
    }
  });

  // ── Animated ASCII hero background ──
  (function() {
    const el = document.getElementById('asciiHero');
    if (!el) return;

    function gabor(x, y, lambda, theta, sigma, phase) {
      const xp = x * Math.cos(theta) + y * Math.sin(theta);
      const yp = -x * Math.sin(theta) + y * Math.cos(theta);
      return Math.exp(-(xp * xp + yp * yp) / (2 * sigma * sigma))
           * Math.cos(2 * Math.PI * xp / lambda + phase);
    }

    const chars = ' .\u00b7:;+=*#%@';
    const cols = 38, rows = 14;
    const filters = [];
    for (let i = 0; i < 2; i++) {
      filters.push({
        theta: (i / 2) * Math.PI + Math.random() * 0.5,
        lambda: 3 + Math.random() * 3,
        sigma: 4 + Math.random() * 3,
        cx: cols * (0.3 + i * 0.4) + (Math.random() - 0.5) * 5,
        cy: rows * 0.5 + (Math.random() - 0.5) * 3,
        weight: 0.5 + Math.random() * 0.5,
        phaseSpeed: 0.2 + Math.random() * 0.3,
        driftSpeed: 0.05 + Math.random() * 0.08,
      });
    }

    let lastFrame = 0;
    function animate(now) {
      if (now - lastFrame > 50) {
        const t = now * 0.001;
        let out = '';
        for (let r = 0; r < rows; r++) {
          for (let c = 0; c < cols; c++) {
            let val = 0;
            for (const f of filters) {
              const x = (c - f.cx) * 0.3;
              const y = (r - f.cy) * 0.6;
              val += gabor(x, y, f.lambda, f.theta + Math.sin(t * f.driftSpeed) * 0.4,
                           f.sigma, t * f.phaseSpeed) * f.weight;
            }
            val = val / filters.length;
            const norm = Math.max(0, Math.min(1, (val + 1) / 2));
            out += chars[Math.floor(norm * (chars.length - 1))];
          }
          out += '\n';
        }
        el.textContent = out;
        lastFrame = now;
      }
      requestAnimationFrame(animate);
    }
    requestAnimationFrame(animate);
  })();
</script>
