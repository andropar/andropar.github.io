---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Now - Johannes Roth">
  <header class="page-header">
    <h1 class="page-title">Now</h1>
    <p class="page-description">
      What I'm focused on right now. Inspired by <a href="https://nownownow.com/about" target="_blank" rel="noopener">the /now page movement</a>.
    </p>
  </header>

  <p class="now-updated">Last updated: December 2024 • Leipzig</p>

  <section class="now-section">
    <div class="now-grid">
      <div class="now-card full-width">
        <h3 class="now-card-title">Working On</h3>
        <div class="now-card-content">
          <p>Wrapping up my PhD - finishing the last experiments and writing up results.</p>
          <p>Starting to look at what comes next (open to opportunities from 2026).</p>
        </div>
      </div>

      <div class="now-card">
        <h3 class="now-card-title">Reading</h3>
        <div class="now-card-content">
          <p>Papers on optimal experimental design and active learning.</p>
          <p>Keeping up with the LLM/multimodal model space.</p>
        </div>
      </div>

      <div class="now-card">
        <h3 class="now-card-title">Side Projects</h3>
        <div class="now-card-content">
          <p>This website - finally making it feel like mine.</p>
          <p>Playing with local LLMs and what they can do for research workflows.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
