---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Johannes Roth is a machine learning engineer and PhD researcher in Leipzig, working on computer vision, data systems, and computational neuroscience." } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const navLinks = [
  { href: '/#capabilities', label: 'skills' },
  { href: '/#experience', label: 'experience' },
  { href: '/#work', label: 'work' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Johannes Roth" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Johannes Roth" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&family=JetBrains+Mono:wght@400;500&family=Raleway:wght@400&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <title>{title}</title>

    <script is:inline>
      (function() {
        var isHome = window.location.pathname === '/' || window.location.pathname === '/index.html';
        var theme = isHome && /^#personal(?:-|$)/.test(window.location.hash) ? 'light' : 'dark';
        try {
          var storedTheme = localStorage.getItem('theme');
          if (storedTheme === 'light' || storedTheme === 'dark') theme = storedTheme;
        } catch (error) {
          // Keep the default theme when storage is unavailable.
        }
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    {import.meta.env.PROD && <script data-goatcounter="https://jroth.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>}
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <nav aria-label="Main navigation">
      <div class="container">
        <a href="/" class="nav-brand">Johannes Roth</a>
        <ul class="nav-links" id="site-navigation">
          {navLinks.map(link => (
            <li><a href={link.href} class="nav-link">{link.label}</a></li>
          ))}
          <li><a href="/blog" class="nav-link" aria-current={Astro.url.pathname.startsWith('/blog') ? 'page' : undefined}>writing</a></li>
        </ul>
        <div class="nav-actions">
          <button class="theme-toggle" type="button" aria-label="Switch to light mode" title="Switch to light mode">
            <svg class="moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a6.8 6.8 0 0 0 9.8 9.8z" />
            </svg>
            <svg class="sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <circle cx="12" cy="12" r="4.5" />
              <path d="M12 2v2.5M12 19.5V22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M2 12h2.5M19.5 12H22M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" />
            </svg>
          </button>
          <button class="nav-menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="site-navigation">
            <span class="nav-menu-lines" aria-hidden="true"></span>
          </button>
          <a href="/cv.pdf" download="Johannes_Roth_CV.pdf" class="nav-cv">CV</a>
        </div>
      </div>
    </nav>

    <main id="main-content"><div class="container"><slot /></div></main>

    <footer>
      <div class="container">
        <span class="footer-text">&copy; {new Date().getFullYear()} Johannes Roth</span>
        <div class="footer-links">
          <a href="mailto:johannes@roth24.de" class="footer-link">Email</a>
          <a href="https://github.com/andropar" class="footer-link" target="_blank" rel="noopener">GitHub</a>
          <a href="https://linkedin.com/in/johannes-roth-a67baa141" class="footer-link" target="_blank" rel="noopener">LinkedIn</a>
          <a href="https://huggingface.co/andropar" class="footer-link" target="_blank" rel="noopener">Hugging Face</a>
          <a href="https://scholar.google.com/citations?user=U3Z3J2gAAAAJ" class="footer-link" target="_blank" rel="noopener">Scholar</a>
        </div>
      </div>
    </footer>

    <script>
      const revealElements = document.querySelectorAll('.timeline-item, .publication, .item, .card, .now-card');
      if ('IntersectionObserver' in window) {
        const revealObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry, index) => {
            if (entry.isIntersecting) {
              setTimeout(() => entry.target.classList.add('revealed'), index * 50);
              revealObserver.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
        revealElements.forEach(el => {
          el.classList.add('reveal');
          revealObserver.observe(el);
        });
      }

      const nav = document.querySelector('nav');
      const navMenuToggle = document.querySelector<HTMLButtonElement>('.nav-menu-toggle');
      const closeNavMenu = () => {
        if (!nav || !navMenuToggle) return;
        nav.removeAttribute('data-menu-open');
        navMenuToggle.setAttribute('aria-expanded', 'false');
        navMenuToggle.setAttribute('aria-label', 'Open navigation');
      };
      if (nav && navMenuToggle) {
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && nav.hasAttribute('data-menu-open')) {
            closeNavMenu();
            navMenuToggle.focus();
          }
        });
        navMenuToggle.addEventListener('click', () => {
          if (nav.getAttribute('data-menu-open') === 'true') {
            closeNavMenu();
          } else {
            nav.setAttribute('data-menu-open', 'true');
            navMenuToggle.setAttribute('aria-expanded', 'true');
            navMenuToggle.setAttribute('aria-label', 'Close navigation');
          }
        });
        document.querySelectorAll('.nav-link').forEach(link => link.addEventListener('click', closeNavMenu));
      }

      const getTheme = () => document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
      const themeToggle = document.querySelector('.theme-toggle');
      function updateThemeToggle() {
        if (!themeToggle) return;
        const theme = getTheme();
        const label = `Switch to ${theme === 'dark' ? 'light' : 'dark'} mode`;
        themeToggle.setAttribute('aria-label', label);
        themeToggle.setAttribute('title', label);
        themeToggle.setAttribute('aria-pressed', String(theme === 'dark'));
      }
      if (themeToggle) {
        updateThemeToggle();
        themeToggle.addEventListener('click', () => {
          const nextTheme = getTheme() === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = nextTheme;
          try { localStorage.setItem('theme', nextTheme); } catch (error) {
            // The active page can still switch themes without storage.
          }
          updateThemeToggle();
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :is(a, button, summary):focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto !important; }
    .reveal { opacity: 1 !important; transform: none !important; transition: none !important; }
  }
</style>
